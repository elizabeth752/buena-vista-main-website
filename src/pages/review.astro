---
/* /review/ — standalone Google review page (ClickUp 86e3qwfvk).

   The alumni coordinator texts this link after discharge, and it can sit
   behind a QR code. No TopBar, no Nav: the page has one job.

   noindex + excluded from the sitemap (astro.config.mjs) so it never shows
   in search.

   4–5 stars are real links straight into Google's write-a-review box for the
   Chandler listing. 1–3 stars open a private feedback form that goes to
   admissions@buena.health. A Google link stays visible on that path too:
   Google prohibits steering unhappy clients away from public reviews
   ("review gating"), so everyone must always have the option. */
import Layout from '../layouts/Layout.astro';

/* Chandler listing. The Place ID decodes to CID 0x91c7d8722540f2b3, the same
   listing LocationSection links to. */
const GOOGLE_REVIEW = 'https://search.google.com/local/writereview?placeid=ChIJ83u00PyrK4cRs_JAJXLYx5E';

const WORDS = ['Poor', 'Fair', 'Okay', 'Good', 'Excellent'];
const STAR = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z';

const band = encodeURI('/Asset/stock photo/Desktop Dimensions/Facility/Sunlit common hall with lounge furniture, tall windows, and open floor plan.webp');
const logo = encodeURI('/Asset/stock photo/Logo Buena Vista.svg');

/* Verbatim excerpts of the Google reviews already used in Testimonials.astro. */
const reviews = [
  { photo: '/Asset/Image%20reviews/Sonia%20Forsgren.svg', name: 'Sonia F.', text: "I am extremely grateful for the monthly Alumni events that we have. It's one of the highlights of my month every single time." },
  { photo: '/Asset/Image%20reviews/Sean%20Brown.svg', name: 'Sean B.', text: 'From detox to out patient the staff go above and beyond to get their patients needs met!' },
  { photo: '/Asset/Image%20reviews/Jennifer%20Mills.svg', name: 'Jennifer M.', text: 'Buena Vista was great for me. Comfortable, good groups, great staff. If I need to return I know they are there.' },
];
---
<Layout
  title="How was your experience? | Buena Vista"
  description="Share your experience at Buena Vista Health & Recovery Centers."
  noindex
>
  <header class="rv-header">
    <img src={logo} alt="Buena Vista Health &amp; Recovery Centers" width="232" height="40" />
  </header>

  <div class="rv-band">
    <img src={band} alt="Sunlit common hall at Buena Vista Chandler" fetchpriority="high" />
  </div>

  <main class="rv-wrap">
    <section class="rv-note" aria-labelledby="rv-q">
      <img class="rv-mark" src="/brand-mark.svg" alt="" width="44" height="44" />
      <h1 id="rv-q">How was your experience at <em>Buena&nbsp;Vista?</em></h1>
      <p class="rv-lead">Thank you for trusting us with your recovery. A few words from you can help the next person find the courage to call.</p>

      <div class="rv-stars" role="radiogroup" aria-label="Rate your experience from 1 to 5 stars" id="rv-stars">
        {WORDS.map((w, i) => {
          const n = i + 1;
          const label = `${n} star${n > 1 ? 's' : ''}, ${w}`;
          const svg = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${STAR}"/></svg>`;
          /* 4 and 5 are plain links so one tap lands in Google's review box. */
          return n >= 4
            ? <a class="rv-star" id={`rv-star-${n}`} data-n={n} href={GOOGLE_REVIEW} target="_blank" rel="noopener" role="radio" aria-checked="false" aria-label={label} set:html={svg} />
            : <button class="rv-star" id={`rv-star-${n}`} data-n={n} type="button" role="radio" aria-checked="false" aria-label={label} set:html={svg} />;
        })}
      </div>
      <p class="rv-word" id="rv-word" aria-live="polite">Tap a star to rate</p>

      <div class="rv-result" data-state="happy" hidden>
        <h2>We're so glad you were here.</h2>
        <p>Google opened in a new tab so you can write your review. If it didn't open, use the button below.</p>
        <div class="rv-btns">
          <a class="rv-btn rv-btn-primary" href={GOOGLE_REVIEW} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={STAR} /></svg>
            Write my Google review
          </a>
        </div>
        <button class="rv-change" type="button">Change my rating</button>
      </div>

      <form class="rv-result rv-fb" data-state="improve" id="rv-feedback" hidden novalidate>
        <h2>Thank you for being honest with us.</h2>
        <p>What could we have done better? Your suggestions go privately to the Buena Vista team, and we read every one.</p>
        <label class="rv-field" for="rv-text">
          <span>How can we improve?</span>
          <textarea id="rv-text" name="feedback" rows="5" required placeholder="Tell us what happened, or what you would change"></textarea>
        </label>
        <div class="rv-row">
          <label class="rv-field" for="rv-name"><span>Name <em>(optional)</em></span><input id="rv-name" name="name" autocomplete="name" /></label>
          <label class="rv-field" for="rv-contact"><span>Phone or email <em>(optional)</em></span><input id="rv-contact" name="contact" autocomplete="email" /></label>
        </div>
        {/* Honeypot. Hidden from people, filled by bots. */}
        <input class="rv-hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="rv-hint">Leave your contact only if you'd like someone from our team to follow up.</p>
        <p class="rv-error" id="rv-error" role="alert" hidden></p>
        <div class="rv-btns">
          <button class="rv-btn rv-btn-primary" type="submit" id="rv-send">Send my feedback</button>
        </div>
        <p class="rv-also">Prefer to post publicly? <a href={GOOGLE_REVIEW} target="_blank" rel="noopener">Leave a Google review</a></p>
        <button class="rv-change" type="button">Change my rating</button>
      </form>

      <div class="rv-result" data-state="sent" hidden>
        <h2>Thank you. We hear you.</h2>
        <p>Your feedback reached our team. If you left your contact, someone will reach out soon.</p>
        <p class="rv-also">You can still <a href={GOOGLE_REVIEW} target="_blank" rel="noopener">leave a Google review</a> if you'd like.</p>
      </div>
    </section>

    <section class="rv-voices" aria-labelledby="rv-voices-h">
      <div>
        <h2 id="rv-voices-h">In the words of our alumni</h2>
        <p class="rv-sub"><img src="/Asset/Accreditations/Google-Reviews.svg" alt="Google Reviews" width="92" height="20" /> Real reviews from people who walked this road.</p>
      </div>
      <div class="rv-cards">
        {reviews.map(r => (
          <figure>
            <blockquote>“{r.text}”</blockquote>
            <figcaption><img src={r.photo} alt="" width="38" height="38" loading="lazy" /><div>{r.name}<span aria-label="Five stars">★★★★★</span></div></figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>

  <footer class="rv-footer">
    <div class="rv-wrap">
      <span>Buena Vista Health &amp; Recovery Centers · 3033 S Arizona Ave, Chandler, AZ 85286</span>
      <span>Need us? <a class="tel-number" href="tel:8883625576">(888) 362-5576</a></span>
    </div>
  </footer>
</Layout>

<script>
  /* Where 1–3 star feedback is delivered. Pending: a Formspree (or similar)
     form tied to admissions@buena.health, confirmed once from that inbox.
     Until it is set, the form refuses to pretend it sent anything. */
  const FEEDBACK_ENDPOINT = '';

  const WORDS = ['Poor', 'Fair', 'Okay', 'Good', 'Excellent'];
  const group = document.getElementById('rv-stars')!;
  const word = document.getElementById('rv-word')!;
  const stars = Array.from(group.querySelectorAll<HTMLElement>('.rv-star'));
  const form = document.getElementById('rv-feedback') as HTMLFormElement;
  const text = document.getElementById('rv-text') as HTMLTextAreaElement;
  const error = document.getElementById('rv-error')!;
  const send = document.getElementById('rv-send') as HTMLButtonElement;
  let current = 0;

  const paint = (n: number) => {
    stars.forEach((s, i) => s.classList.toggle('on', i < n));
    word.textContent = n ? WORDS[n - 1] : 'Tap a star to rate';
  };
  const show = (state: string) => {
    document.querySelectorAll<HTMLElement>('[data-state]').forEach(el => { el.hidden = el.dataset.state !== state; });
  };
  const choose = (n: number) => {
    current = n;
    paint(n);
    stars.forEach((s, i) => s.setAttribute('aria-checked', String(i + 1 === n)));
    show(n >= 4 ? 'happy' : 'improve');
    if (n < 4) setTimeout(() => text.focus(), 50);
    (window as any).dataLayer?.push({ event: 'review_rating', rating: n });
  };

  stars.forEach((s, i) => {
    s.addEventListener('mouseenter', () => paint(i + 1));
    s.addEventListener('focus', () => paint(i + 1));
    s.addEventListener('click', () => choose(i + 1));
  });
  group.addEventListener('mouseleave', () => paint(current));

  document.querySelectorAll('.rv-change').forEach(b => b.addEventListener('click', () => {
    current = 0;
    paint(0);
    show('none');
    stars.forEach(s => s.setAttribute('aria-checked', 'false'));
  }));

  form.addEventListener('submit', async e => {
    e.preventDefault();
    error.hidden = true;
    if (!text.value.trim()) {
      error.textContent = 'Please write a few words before sending.';
      error.hidden = false;
      text.focus();
      return;
    }
    if (!FEEDBACK_ENDPOINT) {
      error.textContent = 'Feedback delivery is not connected yet. Please call us at (888) 362-5576.';
      error.hidden = false;
      return;
    }
    send.disabled = true;
    send.textContent = 'Sending…';
    try {
      const data = new FormData(form);
      data.append('rating', String(current));
      data.append('_subject', `Review page feedback (${current} star${current > 1 ? 's' : ''})`);
      const res = await fetch(FEEDBACK_ENDPOINT, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show('sent');
    } catch {
      error.textContent = "We couldn't send that. Please try again, or call us at (888) 362-5576.";
      error.hidden = false;
    } finally {
      send.disabled = false;
      send.textContent = 'Send my feedback';
    }
  });
</script>

<style>
  .rv-wrap { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: 20px; }

  .rv-header { padding-block: 22px; display: flex; justify-content: center; background: var(--color-cream); }
  .rv-header img { height: 34px; width: auto; }

  .rv-band { position: relative; height: clamp(180px, 34vw, 340px); overflow: hidden; }
  .rv-band img { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; display: block; }
  .rv-band::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(250 247 242 / 0) 40%, var(--color-cream) 100%); }

  .rv-note { position: relative; z-index: 1; margin-top: clamp(-120px, -10vw, -60px); background: #fff; border: 1px solid var(--color-cream-soft); border-radius: 6px; box-shadow: 0 30px 60px -30px rgb(0 43 92 / .25); max-width: 680px; margin-inline: auto; padding: clamp(28px, 5vw, 56px) clamp(20px, 5vw, 64px); text-align: center; display: grid; gap: 18px; }
  .rv-note::before { content: ""; position: absolute; inset: 10px; border: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent); border-radius: 3px; pointer-events: none; }
  .rv-mark { width: 44px; height: 44px; margin: 0 auto; }
  .rv-note h1 { color: var(--color-navy); font-size: clamp(32px, 5.4vw, 52px); line-height: 1.08; letter-spacing: -0.02em; margin: 0; }
  .rv-note h1 em { color: var(--color-gold-deep); font-style: italic; }
  .rv-lead { color: var(--color-muted); max-width: 46ch; margin: 0 auto; }

  .rv-stars { display: flex; justify-content: center; gap: clamp(4px, 1.6vw, 12px); margin-top: 6px; }
  .rv-star { display: inline-block; appearance: none; border: 0; background: none; padding: 6px; cursor: pointer; border-radius: 8px; line-height: 0; }
  .rv-star :global(svg) { width: clamp(44px, 11vw, 60px); height: auto; fill: #fff; stroke: var(--color-sand); stroke-width: 1.4; transition: fill .15s, stroke .15s, transform .15s; }
  .rv-star.on :global(svg) { fill: var(--color-gold); stroke: var(--color-gold); }
  .rv-star:hover :global(svg) { transform: translateY(-2px) scale(1.04); }
  .rv-word { font-family: var(--font-display); font-style: italic; color: var(--color-gold-deep); font-size: 20px; min-height: 1.5em; margin: 0; }

  .rv-result { border-top: 1px solid var(--color-cream-soft); padding-top: 22px; display: grid; gap: 14px; justify-items: center; }
  .rv-result h2 { color: var(--color-navy); font-size: clamp(24px, 3.6vw, 30px); line-height: 1.2; margin: 0; }
  .rv-result p { color: var(--color-muted); max-width: 44ch; margin: 0; line-height: 1.55; }
  .rv-btns { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .rv-btn { display: inline-flex; align-items: center; gap: 10px; font: 600 16px/1 var(--font-body); text-decoration: none; padding: 15px 22px; border-radius: 999px; border: 1.5px solid transparent; cursor: pointer; }
  .rv-btn-primary { background: var(--color-teal); color: #fff; }
  .rv-btn-primary:hover { background: var(--color-teal-dark); }
  .rv-btn-primary:disabled { opacity: .7; cursor: wait; }
  .rv-btn svg { width: 18px; height: 18px; flex: none; }
  .rv-change { font: 600 14px/1 var(--font-body); color: var(--color-muted); background: none; border: 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: 6px; }

  .rv-fb { text-align: left; justify-items: stretch; }
  .rv-fb h2, .rv-fb > p { text-align: center; justify-self: center; }
  .rv-field { display: grid; gap: 6px; font-weight: 600; font-size: 15px; line-height: 1.3; color: var(--color-navy); min-width: 0; }
  .rv-field em { font-style: normal; font-weight: 400; color: var(--color-muted); }
  .rv-field textarea, .rv-field input { width: 100%; font: 400 17px/1.5 var(--font-body); color: var(--color-charcoal); background: var(--color-cream); border: 1.5px solid var(--color-sand); border-radius: 6px; padding: 12px 14px; resize: vertical; }
  .rv-field textarea:focus, .rv-field input:focus { outline: none; border-color: var(--color-teal); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-teal) 25%, transparent); }
  .rv-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .rv-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .rv-fb .rv-hint { font-size: 14px; }
  .rv-fb .rv-error { color: #9B2C2C; font-weight: 600; font-size: 15px; }
  .rv-also { font-size: 15px; }
  .rv-also a { color: var(--color-teal-dark); font-weight: 600; }

  .rv-voices { padding-block: clamp(56px, 8vw, 96px) 40px; display: grid; gap: 28px; }
  .rv-voices > div:first-child { display: grid; gap: 8px; max-width: 640px; }
  .rv-voices h2 { color: var(--color-navy); font-size: clamp(28px, 4vw, 40px); line-height: 1.12; margin: 0; }
  .rv-sub { color: var(--color-muted); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0; }
  .rv-sub img { height: 20px; width: auto; }
  .rv-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
  .rv-cards figure { margin: 0; background: #fff; border: 1px solid var(--color-cream-soft); border-radius: 6px; padding: 24px; display: grid; gap: 16px; align-content: start; }
  .rv-cards blockquote { margin: 0; font-family: var(--font-display); font-size: 20px; line-height: 1.45; color: var(--color-charcoal); }
  .rv-cards figcaption { display: flex; align-items: center; gap: 12px; font-weight: 600; line-height: 1.3; }
  .rv-cards figcaption img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }
  .rv-cards figcaption span { display: block; color: #E3A008; font-size: 13px; letter-spacing: 1px; font-weight: 400; }

  .rv-footer { border-top: 1px solid var(--color-cream-soft); padding-block: 28px 40px; color: var(--color-muted); font-size: 15px; }
  .rv-footer .rv-wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
  .rv-footer a { color: var(--color-navy); font-weight: 600; text-decoration: none; }

  @media (prefers-reduced-motion: reduce) {
    .rv-star :global(svg) { transition: none; }
    .rv-star:hover :global(svg) { transform: none; }
  }
</style>
