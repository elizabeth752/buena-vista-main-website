---
/* -----------------------------------------------------------------------------
   Chandler, AZ — facility page.

   This is the NAP source of truth for the brand. Every fact below is taken from
   the client wiki: address, facility line, 24-hour opening,
   amenities, accessibility, and the scope of care.

   Scope was detox + residential ONLY until 2026-09-21, matching the Jan–Jul
   2026 call export, in which BV agents repeatedly confirm Chandler ran no
   outpatient, PHP or IOP. The client confirmed on 2026-09-21 that the full
   continuum is open and asked for it to be presented that way, so PHP, IOP and
   outpatient treatment are now stated here. Medication-assisted treatment is
   still NOT offered. Do not add further levels of care without confirming with
   admissions first.
----------------------------------------------------------------------------- */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';

import ChandlerHero from '../../components/chandler/ChandlerHero.astro';
import ChandlerCare from '../../components/chandler/ChandlerCare.astro';
import ChandlerPractical from '../../components/chandler/ChandlerPractical.astro';
import GettingHere from '../../components/chandler/GettingHere.astro';

import FacilityGallery from '../../components/FacilityGallery.astro';
import Testimonials from '../../components/Testimonials.astro';
import VerifySection from '../../components/VerifySection.astro';
import ChandlerToc from '../../components/chandler/ChandlerToc.astro';
import WhatWeTreat from '../../components/WhatWeTreat.astro';
import OurTeam from '../../components/OurTeam.astro';
import AdmissionsPath from '../../components/AdmissionsPath.astro';
import FAQ from '../../components/FAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const title = 'Drug & Alcohol Rehab in Chandler, AZ | Buena Vista';
const description =
  'Detox, residential, PHP, IOP and outpatient addiction treatment at 3033 S Arizona Ave, Chandler, AZ. Private rooms, open 24 hours, most major insurance and AHCCCS accepted. Call (888) 362-5576.';

// LocalBusiness schema for the one facility.
/* Location FAQ, per the Recovery.com checklist: practical questions people ask
   about this building specifically, not about treatment in general. */
const faqs = [
  {
    q: 'Where exactly is the Chandler facility?',
    a: "We are at 3033 S Arizona Avenue in Chandler, AZ 85286, on the east side of Arizona Avenue with a covered entrance and parking on site. The building is open 24 hours a day, every day of the year including holidays, and somebody is at the desk whatever time you arrive. If you are driving in from Phoenix it is a straight run down the I-10, and from Gilbert, Mesa or Tempe it is a local drive rather than a journey.",
  },
  {
    q: 'Can I just turn up at the building?',
    a: "Please call before you come. A phone assessment and a benefits check have to happen first, and a provider needs to confirm that the level of care is right and safe for you. That call is what lets us hold a bed, complete the medical review and have someone expecting you, rather than leaving you waiting at a door. It takes ten to twenty minutes and the line is answered at any hour.",
  },
  {
    q: 'What is on site at Chandler?',
    a: "The full continuum: medical detox, residential treatment, partial hospitalization, intensive outpatient and outpatient treatment, all in the same building, so you move between levels without a second admission or a change of team. In the residential phase you get a private room with a private bathroom, catered meals, group therapy twice a day and one-to-one sessions with your own therapist. Nursing and support staff are on site around the clock.",
  },
  {
    q: 'Is there parking, and can family visit here?',
    a: "There is parking on site and a covered entrance for drop-off. Family visiting happens on a schedule so it does not cut across the therapeutic day, and your case manager will walk your family through how it works once you are admitted. Being close enough for family to visit without booking a flight is one of the arguments for treating in the East Valley rather than travelling out of state.",
  },
  {
    q: 'How do I get there if I cannot drive?',
    a: "Say so when you call. We can arrange transport within our local service area, and it is one of the last practical barriers we can take off the table for someone who has already decided to come in. If you are flying in, Sky Harbor is the nearest airport. If you are coming from further out in Arizona, tell the admissions team where from and they will work the journey out with you.",
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Buena Vista Health & Recovery Centers — Chandler',
  description,
  url: 'https://buenavistarecovery.com/locations/chandler/',
  logo: '/Asset/stock%20photo/Logo%20Buena%20Vista.svg',
  telephone: '+1-480-680-0606',
  medicalSpecialty: 'Addiction Medicine',
  isAcceptingNewPatients: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3033 S Arizona Ave',
    addressLocality: 'Chandler',
    addressRegion: 'AZ',
    postalCode: '85286',
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  availableService: [
    { '@type': 'MedicalTherapy', name: 'Medical Detox' },
    { '@type': 'MedicalTherapy', name: 'Residential Treatment' },
    { '@type': 'MedicalTherapy', name: 'Partial Hospitalization Program' },
    { '@type': 'MedicalTherapy', name: 'Intensive Outpatient Program' },
    { '@type': 'MedicalTherapy', name: 'Outpatient Treatment' },
    { '@type': 'MedicalTherapy', name: 'Dual Diagnosis Treatment' },
  ],
  areaServed: ['Chandler', 'Phoenix', 'Mesa', 'Gilbert', 'Tempe', 'Scottsdale', 'Arizona'].map(n => ({
    '@type': 'AdministrativeArea',
    name: n,
  })),
};
---
<Layout title={title} description={description}>
  <TopBar />
  <Nav />

  <ChandlerHero />
  <ChandlerToc />
  <ChandlerCare />
  <FacilityGallery />
  <ChandlerPractical />
  <VerifySection heading="Does your insurance cover treatment in Chandler?" />
  <OurTeam
    eyebrow="Who looks after you here"
    heading="The clinical team at Chandler"
    bg="bg-white"
  />
  <Testimonials />
  <WhatWeTreat />
  <AdmissionsPath
    heading="How to start treatment at our Chandler facility"
    bg="bg-cream"
    ring="ring-cream"
    noteBg="bg-navy-deep"
  />
  <GettingHere />
  <FAQ faqs={faqs} eyebrow="Straight answers" heading="Questions about our Chandler facility" bg="bg-sage-tint" />

  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>
