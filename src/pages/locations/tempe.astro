---
/* -----------------------------------------------------------------------------
   Serving Tempe — SERVICE-AREA page, not a location page.

   Tempe skews younger and more employment-anxious than the other East Valley cities. Work and study are the angles worth answering.

   ⚠ NOT A LOCATION PAGE. There is no Tempe facility. This page carries NO
   LocalBusiness schema and NO Tempe NAP, and the hero states plainly that
   the single building is in Chandler. A fake location page risks a Google
   penalty and, worse, sends someone in crisis to an address that does not
   exist. Keep all three guardrails.

   ⚠ NO INVENTED DRIVE TIMES. Naming a freeway or a surface street is a fact.
   A figure in minutes is not one anybody has verified against traffic.
----------------------------------------------------------------------------- */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';

import ServiceAreaHero from '../../components/servicearea/ServiceAreaHero.astro';
import ServiceAreaBody from '../../components/servicearea/ServiceAreaBody.astro';

import Testimonials from '../../components/Testimonials.astro';
import VerifySection from '../../components/VerifySection.astro';
import AdmissionsPath from '../../components/AdmissionsPath.astro';
import FAQ from '../../components/FAQ.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const title = "Drug and Alcohol Rehab Serving Tempe, Arizona | Buena Vista";
const description = "Medical detox and residential treatment serving Tempe from our Chandler, AZ facility, a short run down the I-10 or the 101. AHCCCS accepted, open 24 hours. Call (888) 362-5576.";

const points = [
      { text: "A straightforward run south on the I-10 or the 101", d: "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" },
      { text: "Medical detox and residential treatment, open 24 hours", d: "M21 8.25H3m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 8.25m18 0v10.5A2.25 2.25 0 0118.75 21H5.25A2.25 2.25 0 013 18.75V8.25M12 11.25v6m3-3H9" },
      { text: "Your job is protected while you are in treatment", d: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" },
      { text: "We can often arrange a ride to bring you in", d: "M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" },
      { text: "AHCCCS plans and most major commercial and private carriers", d: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" },
];

const routes = [
  { h: "Downtown Tempe and ASU", p: "South on Rural or Mill and then the 101 or the I-10. One of the shorter journeys we see." },
  { h: "South Tempe and the Lakes", p: "Practically next door. Straight down Rural, McClintock or Kyrene and you are here." },
  { h: "West Tempe and Guadalupe", p: "The I-10 south, then east on Chandler Boulevard or Ray." },
  { h: "No car at all", p: "Say so on the call. Transport within our local service area is something we can often arrange, and Tempe is inside it." },
];

const why = [
  { h: "Keeping a job", p: "The most common reason people put off calling. Your treatment is confidential, so your employer has no right to know why you are away, and you may be eligible for FMLA leave that protects your job without you disclosing the reason. Bring it up on the call and the team will walk you through it." },
  { h: "Studying and coming back", p: "Treatment is time-limited by design. Around thirty days for residential, less for detox alone, and your case manager plans the return with you rather than leaving you to work it out at discharge." },
  { h: "Staying reachable", p: "Phone access runs in the evenings once you move into residential, so the people who depend on you are not cut off for a month." },
];

const faqs = [
  { q: "Do you have a facility in Tempe?", a: "No. Buena Vista operates one facility, at 3033 S Arizona Ave in Chandler, and serves Tempe from there. It is a short run south on the I-10 or the 101, and being slightly outside your own neighborhood is generally an advantage rather than a cost while you are in treatment." },
  { q: "Will my employer find out?", a: "Not from us. Your treatment is confidential under federal privacy law and we cannot disclose it to an employer. If you need time off, you may be eligible for leave under the Family and Medical Leave Act, which protects your job without requiring you to give the specific reason. Raise it during your phone assessment and we will talk it through." },
  { q: "Can I keep studying or working while in treatment?", a: "Not during residential, which is live-in and designed to be the only thing on your calendar for about a month. That is the point of it, and it is a shorter interruption than most people fear. Your case manager plans the return to work or study with you from early in the stay rather than in the final week." },
  { q: "How long does it take to get there from Tempe?", a: "A short drive. From south Tempe it is essentially straight down Rural, McClintock or Kyrene; from downtown or ASU it is the 101 or the I-10 south. We will not put a figure in minutes on it, because traffic on the I-10 makes that unreliable, but it is one of the shorter journeys we see." },
  { q: "Does AHCCCS cover this if I live in Tempe?", a: "Coverage follows your plan rather than your address. We work with AHCCCS plans and with most major commercial and private carriers, and we check your specific plan while you are on the phone, at no cost and with nothing owed either way." },
];

// FAQPage only — deliberately no LocalBusiness/MedicalClinic schema, because
// there is no Tempe facility to describe.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout title={title} description={description}>
  <TopBar />
  <Nav />

  <ServiceAreaHero
    city="Tempe"
    title="Treatment for Tempe, a short run down the Valley."
    points={points}
    disclosure="Buena Vista is one facility, at 3033 S Arizona Ave in Chandler. There is no separate Tempe building. We serve Tempe from Chandler, a short way south of the city."
    image="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Shared%20commons%20area%20with%20clustered%20seating,%20dining%20nook,%20and%20residential%20finishes.webp"
    alt="A commons area at Buena Vista with armchairs clustered around a low table"
    caption="A month out of the routine, a short drive from Tempe."
  />

  <ServiceAreaBody
    city="Tempe"
    routesTitle="Coming down from Tempe"
    routesIntro="Tempe sits just north of us, so this is a short and simple drive whichever route you take."
    routes={routes}
    whyTitle="What people from Tempe tend to ask about"
    why={why}
  />

  <VerifySection heading="Does your insurance cover treatment from Tempe?" />
  <Testimonials />
  <AdmissionsPath
    heading="How to start treatment from Tempe"
    bg="bg-white"
    ring="ring-white"
    noteBg="bg-navy-deep"
  />
  <FAQ faqs={faqs} eyebrow="Straight answers" heading="Questions from Tempe" bg="bg-cream" />

  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>
