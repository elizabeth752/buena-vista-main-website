---
/* -----------------------------------------------------------------------------
   Careers.

   Built because /careers/ on the old site earns 239 clicks in 90 days at a
   12.9% click-through rate, the highest on the whole domain, and the new build
   had nowhere for it to land. The old URL redirects here.

   ⚠ NO HEADCOUNT CLAIMS. Never state team size, number of staff, or how many
   people work here. The number rots and the site never lists everyone.

   ⚠ NO PAY RANGES, no benefits specifics and no open-role list until somebody
   at Buena Vista confirms them. An out-of-date vacancy is worse than none.

   The differentiator that IS corroborated: a large share of staff are in
   recovery themselves. That is the thing worth leading on.
----------------------------------------------------------------------------- */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import Horizon from '../../components/Horizon.astro';
import ApplyForm from '../../components/careers/ApplyForm.astro';
import OurTeam from '../../components/OurTeam.astro';
import Testimonials from '../../components/Testimonials.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const title = 'Careers at Buena Vista Health & Recovery, Chandler AZ';
const description =
  'Work at Buena Vista Health & Recovery Centers in Chandler, Arizona. Clinical, nursing and support roles at a facility open 24 hours. Tell us you are interested and we will call you back.';

const points = [
  { text: 'A great many of our staff are in recovery themselves',
    d: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z' },
  { text: 'One building in Chandler, so nobody is stretched across sites',
    d: 'M21 8.25H3m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 8.25m18 0v10.5A2.25 2.25 0 0118.75 21H5.25A2.25 2.25 0 013 18.75V8.25M12 11.25v6m3-3H9' },
  { text: 'Detox and residential under one roof, so you see people through',
    d: 'M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3' },
  { text: 'Clinical, nursing, admissions and support roles',
    d: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z' },
  { text: 'The building runs 24 hours, so nights and weekends are real shifts',
    d: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' },
];

const what = [
  { h: 'Clinical', p: 'Therapists and counselors running the twice-daily groups and the one-to-one sessions, with a caseload built around doing the work properly rather than clearing a queue.' },
  { h: 'Nursing', p: 'The team that never closes. Detox monitoring, comfort medication and the three in the morning admissions, alongside a physician who reviews every case.' },
  { h: 'Admissions', p: 'The first voice somebody hears, often at the worst moment of their life. The job is a straight answer and a bed, not a script and a callback queue.' },
  { h: 'Support and operations', p: 'Kitchen, housekeeping, transport and the front desk. People remember the meals and whoever met them at the door as clearly as they remember the therapy.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Careers at Buena Vista Health & Recovery Centers',
  description,
  url: 'https://buenavistarecovery.com/about/careers/',
  publisher: {
    '@type': 'MedicalOrganization',
    name: 'Buena Vista Health & Recovery Centers',
    telephone: '+1-888-362-5576',
    address: {
      '@type': 'PostalAddress', streetAddress: '3033 S Arizona Ave',
      addressLocality: 'Chandler', addressRegion: 'AZ', postalCode: '85286', addressCountry: 'US',
    },
  },
};
---
<Layout title={title} description={description}>
  <TopBar />
  <Nav />

  <section id="hero" class="bg-cream">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
      <div class="grid lg:grid-cols-[1fr_minmax(0,430px)] gap-12 lg:gap-16 items-start">
        <div>
          <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
            <span class="w-6 h-px bg-gold inline-block"></span>
            Careers
          </p>

          <h1 class="font-display text-navy mb-6">Careers at Buena Vista in Chandler, Arizona</h1>

          <ul class="space-y-4 mb-9">
            {points.map(item => (
              <li class="flex items-start gap-3.5 font-body text-charcoal text-[17px] leading-[29px]">
                <span class="w-9 h-9 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-[19px] h-[19px] text-teal" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
                  </svg>
                </span>
                <span>{item.text}</span>
              </li>
            ))}
          </ul>

          <div class="border-l-2 border-gold pl-5 max-w-xl">
            <p class="font-body text-charcoal text-[16px] leading-[26px]">
              <strong class="font-bold">If you are in recovery yourself, say so.</strong> It is not something to work around here. Clients tell us constantly that the difference they feel is staff who have actually been where they are, and that is not something you can train into somebody.
            </p>
          </div>
        </div>

        <ApplyForm id="apply" class="lg:sticky lg:top-24" />
      </div>
    </div>
  </section>

  <section id="roles" class="bg-white py-[70px]">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          The work
        </p>
        <h2 class="font-display text-charcoal mb-5">The kinds of roles at our Chandler facility</h2>
        <p class="font-body text-charcoal text-[18px] leading-[30px]">
          Rather than list vacancies that go stale, tell us what you do and we will tell you honestly whether there is something open.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {what.map(w => (
          <div class="bg-cream rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold h-full">
            <h3 class="role-title font-display text-navy mb-3">{w.h}</h3>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{w.p}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-col sm:flex-row gap-4">
        <a href="#apply" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
          Tell us you are interested
        </a>
        <a href="tel:8883625576" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
          <span class="tel-number">Call (888) 362-5576</span>
        </a>
      </div>
    </div>
  </section>

  <OurTeam eyebrow="Who you would be working with" heading="The people already here" bg="bg-cream" />
  <Testimonials />

  <section class="bg-white py-[70px]">
    <div class="max-w-4xl mx-auto px-5 sm:px-6 lg:px-8">
      <Horizon variant="rule" class="mb-8" />
      <h2 class="font-display text-charcoal mb-5">What happens after you get in touch</h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] mb-4">
        Somebody from our team calls you back. That first conversation is about what you do, what you are looking for, and whether there is anything open that fits. If there is not, we will say so rather than leaving you waiting.
      </p>
      <p class="font-body text-charcoal text-[17px] leading-[29px]">
        Bring your CV to that call if you have one to hand. You do not need it to get in touch.
      </p>
    </div>
  </section>

  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>

<style>
  /* Unlayered, so it beats the global h3 scale. */
  .role-title { font-size: 21px; line-height: 27px; letter-spacing: 0; }
</style>
