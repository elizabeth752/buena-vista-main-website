---
import Layout from '../../../layouts/Layout.astro';
import TopBar from '../../../components/TopBar.astro';
import Nav from '../../../components/Nav.astro';
import VerifySection from '../../../components/VerifySection.astro';
import FinalCTA from '../../../components/FinalCTA.astro';
import Horizon from '../../../components/Horizon.astro';
import { publishedTeam } from '../../../data/team';
import posts from '../../../data/blog/posts.json';

/* Individual team pages. These exist for E-E-A-T: a byline that links to a real
   person with real credentials is worth more than a name in grey text, and the
   Person schema here is what the article schema's author/reviewedBy point at.

   ⚠ Only people actually on staff. The old WordPress site has bios for nine
   different people from before the takeover — do not add them here without
   confirmation from the client. */
export function getStaticPaths() {
  return publishedTeam.map(m => ({ params: { slug: m.slug }, props: { member: m } }));
}

const { member } = Astro.props;
const written = posts.filter(p => p.author === member.slug);
const reviewed = member.clinicalReviewer
  ? posts.filter(p => p.author !== member.slug && member.slug === 'will-heise')
  : [];

const url = `https://buenavistarecovery.com/about/team/${member.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${member.name}${member.credentials ? ', ' + member.credentials : ''}`,
  jobTitle: member.title,
  url,
  image: `https://buenavistarecovery.com${member.photo}`,
  worksFor: {
    '@type': 'MedicalOrganization',
    name: 'Buena Vista Health & Recovery Centers',
    telephone: '+1-888-362-5576',
    address: {
      '@type': 'PostalAddress', streetAddress: '3033 S Arizona Ave',
      addressLocality: 'Chandler', addressRegion: 'AZ', postalCode: '85286', addressCountry: 'US',
    },
  },
};
---
<Layout
  title={`${member.name}${member.credentials ? ', ' + member.credentials : ''} — ${member.title} | Buena Vista`}
  description={`${member.name}${member.credentials ? ', ' + member.credentials : ''} is ${member.title} at Buena Vista Health & Recovery Centers, Chandler, Arizona. Call (888) 362-5576.`}
  ogImage={member.photo}
>
  <TopBar />
  <Nav />

  <section class="bg-cream py-[60px] lg:py-[70px]">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 font-body text-[14px] text-muted">
          <li><a href="/" class="hover:text-teal transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/about/" class="hover:text-teal transition-colors">About</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-charcoal">{member.name}</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_340px] gap-12 lg:gap-16 items-start">
        <div>
          <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
            <span class="w-6 h-px bg-gold inline-block"></span>
            {member.title}
          </p>
          <h1 class="font-display text-navy mb-6">
            {member.name}{member.credentials ? `, ${member.credentials}` : ''}
          </h1>

          <div class="space-y-5 max-w-2xl">
            {member.bio.map(par => (
              <p class="font-body text-charcoal text-[17px] leading-[29px]">{par}</p>
            ))}
          </div>

          <div class="mt-9">
            <p class="font-body text-muted text-[13px] font-bold tracking-[0.12em] uppercase mb-4">Focus</p>
            <ul class="flex flex-wrap gap-2.5">
              {member.focus.map(f => (
                <li class="bg-white border border-cream-soft font-body text-charcoal/80 text-[15px] font-semibold px-4 py-2 rounded-full">{f}</li>
              ))}
            </ul>
          </div>

          <div class="mt-9 flex flex-col sm:flex-row gap-4">
            <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
              Talk to our team
            </a>
            <a href="/about/" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
              Meet everyone
            </a>
          </div>
        </div>

        <div>
          <div class="overflow-hidden rounded-t-[140px] rounded-b-xl shadow-xl bg-white">
            <img src={member.photo} alt={`${member.name}, ${member.title} at Buena Vista`} class="w-full object-cover aspect-[4/5]" fetchpriority="high" decoding="async" />
          </div>
          <Horizon variant="rule" class="mt-5" />
          <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
            {member.title}, Buena Vista Health &amp; Recovery Centers, Chandler.
          </p>
        </div>
      </div>
    </div>
  </section>

  {(written.length > 0 || reviewed.length > 0) && (
    <section class="bg-white py-[60px]">
      <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Articles
        </p>
        <h2 class="font-display text-charcoal mb-9">
          {written.length > 0 ? `Written by ${member.name}` : `Clinically reviewed by ${member.name}`}
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
          {(written.length > 0 ? written : reviewed).slice(0, 6).map(p => (
            <a href={`/blog/${p.slug}/`} class="group bg-cream rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold h-full block hover:border-teal transition-colors">
              <p class="font-body text-gold text-xs font-bold tracking-[0.14em] uppercase mb-3">{p.category}</p>
              <h3 class="member-post font-display text-navy mb-2">{p.title}</h3>
              <p class="font-body text-muted text-[15px]">{p.readMinutes} min read</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <VerifySection heading="Does your insurance cover treatment at Buena Vista?" bg="bg-cream" />
  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>

<style>
  /* Unlayered, so it beats the global h3 scale. */
  .member-post { font-size: 20px; line-height: 27px; letter-spacing: 0; min-height: 81px; }
</style>
