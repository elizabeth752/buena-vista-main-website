---
/* Programs hub. Scope became the full continuum on 2026-09-21, when the client
   confirmed PHP, IOP and outpatient treatment are open and asked for them to be
   presented as live programs. Before that this page ran detox + residential and
   named the outpatient levels as things we would help someone reach elsewhere.
   Sober living is still a referral, not a service. */
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import HubHero from '../../components/hub/HubHero.astro';
import HubCards from '../../components/hub/HubCards.astro';
import Testimonials from '../../components/Testimonials.astro';
import VerifySection from '../../components/VerifySection.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const title = 'Programs & Levels of Care | Buena Vista, Chandler AZ';
const description = 'The full continuum of care in Chandler, AZ: medical detox, residential treatment, PHP, IOP and outpatient treatment, with co-occurring mental health care throughout. Call (888) 362-5576.';

const levels = [
  { label: 'Medical detox', tag: '4–7 days', desc: 'Around-the-clock nursing, physician oversight and medication to keep you comfortable while your body clears. The starting point for alcohol, opioids and benzodiazepines.', href: '/medical-detox' },
  { label: 'Residential treatment', tag: 'Around 30 days', desc: 'Live-in care once your body is stable. Group therapy twice a day, one-to-one sessions and a case manager planning what comes after.', href: '/residential-treatment' },
  { label: 'Partial hospitalization (PHP)', tag: 'A full clinical day', desc: 'The structure of residential care without living on site. The usual step down once you are steady enough to sleep somewhere else.', href: '/programs/partial-hospitalization-php/' },
  { label: 'Intensive outpatient (IOP)', tag: 'Part of the day', desc: 'A few hours at a time, several days a week, built around a working life. Groups, therapy and relapse-prevention work continue.', href: '/programs/intensive-outpatient-iop/' },
  { label: 'Outpatient treatment', tag: '45–90 days', desc: 'Where treatment and real life overlap. Support continues while work, home, family and a new routine come back in around it.', href: '/programs/outpatient-program/' },
  { label: 'Dual diagnosis care', tag: 'Throughout', desc: 'Depression, anxiety, PTSD and trauma treated alongside substance use at every level of care rather than as a separate track.', href: '/dual-diagnosis' },
];

const alongside = [
  { label: 'Aftercare planning', desc: 'Ongoing therapy, a primary care provider and community support, arranged before your last session rather than after it.', href: '/programs/aftercare/' },
  { label: 'Sober living', desc: 'We refer rather than operate. Placement help is part of the step-down phases, and we know the local landscape well.', href: '/resources/sober-living-arizona/' },
  { label: 'Therapies', desc: 'The clinical approaches used across the continuum, from individual and group therapy to trauma-focused work.', href: '/therapies/' },
];
---
<Layout title={title} description={description}>
  <TopBar /><Nav />
  <HubHero
    eyebrow="Programs & levels of care"
    title="Treatment Programs and Levels of Care"
    intro="The full continuum happens in the same building with the same team, from medical detox through to outpatient treatment, so stepping down a level never means starting again somewhere new."
    points={['Medically supervised detox with nursing on site 24/7','Residential treatment with private rooms and en suite bathrooms','PHP, IOP and outpatient treatment as the steps down','Co-occurring mental health care throughout, not bolted on']}
    image="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Grand%20entrance%20hall%20with%20vaulted%20ceiling,%20lounge%20seating,%20and%20open%20circulation%20space.webp"
    alt="The entrance hall at Buena Vista, with vaulted ceiling and lounge seating"
    caption="One building, start to finish."
  />
  <HubCards
    eyebrow="What we run"
    title="The levels of care we provide at Chandler"
    intro="Most people move through these in this order, stepping down as they steady. Where you start depends on where you are, and a short call settles it."
    items={levels}
  />
  <HubCards
    eyebrow="Alongside the program"
    title="What runs with it"
    intro="Not everyone starts at the top of the list, and not everything somebody needs is a level of care. Call us anyway — working out the right plan, including at other facilities when that is the honest answer, is a normal part of what our admissions team does."
    items={alongside}
    bg="bg-sage-tint"
  />
  <Testimonials /><VerifySection />
  <FinalCTA />
</Layout>
