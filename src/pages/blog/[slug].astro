---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Nav from '../../components/Nav.astro';
import ArticleMeta from '../../components/blog/ArticleMeta.astro';
import ArticleToc from '../../components/blog/ArticleToc.astro';
import ShareBar from '../../components/blog/ShareBar.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import VerifySection from '../../components/VerifySection.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { bySlug } from '../../data/team';
import posts from '../../data/blog/posts.json';

/* Article template for the migrated blog.

   ⚠ These posts came across from the WordPress site because they earn real
   search traffic. The prose is the original author's; it has NOT been rewritten
   or fact-checked against the call data, so it does not yet follow the site's
   copy rules and may contain claims nobody here has verified. Treat a rewrite
   as its own pass. What is new is the structure around it: a real byline, a
   named clinical reviewer, an updated date, headings that anchor, and links
   into the treatment pages.

   ⚠ E-E-A-T: the author and reviewer must be real people in src/data/team.ts.
   Never invent a byline to fill the slot. */
export function getStaticPaths() {
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const person = bySlug[post.author];
const reviewer = person?.clinicalReviewer ? person : bySlug['will-heise'];

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);

// H2s carry ids so the table of contents can anchor to them.
const headings = post.blocks
  .filter((b: any) => b.t === 'h2')
  .map((b: any) => ({ id: slugify(b.html), text: b.html }));

const url = `https://buenavistarecovery.com/blog/${post.slug}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: post.title,
  description: post.description,
  url,
  dateModified: post.updated,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: `${person.name}${person.credentials ? ', ' + person.credentials : ''}`,
    jobTitle: person.title,
    url: `https://buenavistarecovery.com/about/team/${person.slug}/`,
  },
  reviewedBy: {
    '@type': 'Person',
    name: `${reviewer.name}, ${reviewer.credentials}`,
    jobTitle: reviewer.title,
    url: `https://buenavistarecovery.com/about/team/${reviewer.slug}/`,
  },
  publisher: {
    '@type': 'MedicalOrganization',
    name: 'Buena Vista Health & Recovery Centers',
    telephone: '+1-888-362-5576',
    address: {
      '@type': 'PostalAddress', streetAddress: '3033 S Arizona Ave',
      addressLocality: 'Chandler', addressRegion: 'AZ', postalCode: '85286', addressCountry: 'US',
    },
  },
};
---
<Layout title={`${post.metaTitle ?? post.title} | Buena Vista`} description={post.description} ogType="article">
  <TopBar />
  <Nav />

  <article>
    <header class="bg-cream pt-[50px] pb-[40px]">
      <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 font-body text-[14px] text-muted">
            <li><a href="/" class="hover:text-teal transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog/" class="hover:text-teal transition-colors">Blog</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-charcoal">{post.category}</li>
          </ol>
        </nav>

        <div class="max-w-4xl">
          <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
            <span class="w-6 h-px bg-gold inline-block"></span>
            {post.category}
          </p>
          <h1 class="font-display text-navy mb-6">{post.title}</h1>
          {post.description && (
            <p class="font-body text-charcoal text-[19px] leading-[31px] max-w-3xl">{post.description}</p>
          )}
        </div>
      </div>
    </header>

    <div class="bg-white pb-[60px]">
      <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <ArticleMeta author={post.author} updated={post.updated} readMinutes={post.readMinutes} category={post.category} />
        </div>

        <div class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-12 lg:gap-16 mt-10">
          <div class="prose-bv max-w-3xl">
            {post.blocks.map((b: any) => (
              b.t === 'h2' ? <h2 id={slugify(b.html)} set:html={b.html} />
              : b.t === 'h3' ? <h3 set:html={b.html} />
              : b.t === 'p'  ? <p set:html={b.html} />
              : b.t === 'ul' ? <ul>{b.items.map((i: string) => <li set:html={i} />)}</ul>
              : b.t === 'embed' ? (
                /* Podcast episode. referrerpolicy is not decoration: without it
                   the embed hands Spotify the full article URL, and on this site
                   a URL is a diagnosis. Lazy so it never blocks the article. */
                <figure class="not-prose my-10">
                  <iframe
                    src={b.src}
                    title={b.title}
                    width="100%"
                    height="232"
                    frameborder="0"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                    class="rounded-xl w-full"
                  ></iframe>
                  {b.caption && <figcaption class="font-body text-muted text-[15px] leading-[24px] mt-3" set:html={b.caption} />}
                </figure>
              )
              : <ol>{b.items.map((i: string) => <li set:html={i} />)}</ol>
            ))}

            {/* Every article routes onward into treatment rather than ending. */}
            <aside class="not-prose bg-cream rounded-xl border border-cream-soft border-t-4 border-t-gold p-7 mt-12">
              <p class="font-display text-navy text-[22px] leading-[29px] mb-3">Talk to someone about this</p>
              <p class="font-body text-charcoal text-[16px] leading-[26px] mb-5">
                Our admissions line is answered at any hour, including holidays. Nothing is decided on that first call.
              </p>
              <div class="flex flex-wrap gap-3 mb-6">
                <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-7 rounded-lg transition-colors font-body">
                  <span class="tel-number">Call (888) 362-5576</span>
                </a>
                <a href="/insurance/verify-your-benefits/" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-7 rounded-lg transition-colors font-body">
                  Check my coverage
                </a>
              </div>
              <ul class="space-y-2">
                {post.links.map(([href, label]: [string, string]) => (
                  <li>
                    <a href={href} class="font-body text-teal font-semibold text-[16px] hover:opacity-70 transition-opacity">{label} &rarr;</a>
                  </li>
                ))}
              </ul>
            </aside>

            <div class="not-prose mt-10 pt-8 border-t border-cream-soft">
              <ShareBar url={url} title={post.title} />
            </div>
          </div>

          <div class="order-first lg:order-last">
            <ArticleToc headings={headings} />
          </div>
        </div>
      </div>
    </div>
  </article>

  <RelatedPosts slug={post.slug} category={post.category} />
  <VerifySection heading="Does your insurance cover treatment at Buena Vista?" bg="bg-white" />
  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>
