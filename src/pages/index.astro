---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import DontGiveUp from '../components/DontGiveUp.astro';
import VerifySection from '../components/VerifySection.astro';
import SpaceBuilt from '../components/SpaceBuilt.astro';
import FacilityGallery from '../components/FacilityGallery.astro';
import TreatmentPillars from '../components/TreatmentPillars.astro';
import LevelsOfCare from '../components/LevelsOfCare.astro';
import WhatWeTreat from '../components/WhatWeTreat.astro';
import OurTeam from '../components/OurTeam.astro';
import Insurance from '../components/Insurance.astro';
import HowToStart from '../components/HowToStart.astro';
import LocationSection from '../components/LocationSection.astro';
import FacilityShowcase from '../components/FacilityShowcase.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
---
<Layout>
  <TopBar />
  <Nav />

  <!-- Warm open, no form. Both audiences are spoken to before anything is asked. -->
  <Hero />
  <DontGiveUp />

  <!-- The coverage check sits here rather than as a co-hero. -->
  <VerifySection />

  <LevelsOfCare />
  <FacilityGallery />
  <SpaceBuilt />
  <TreatmentPillars />
  <WhatWeTreat />
  <OurTeam />
  <Insurance />
  <HowToStart />
  <FacilityShowcase />
  <Testimonials />
  <LocationSection />
  <FAQ />

  <FinalCTA />
</Layout>
