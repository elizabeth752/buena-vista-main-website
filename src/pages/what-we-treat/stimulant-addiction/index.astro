---
/* -----------------------------------------------------------------------------
   Stimulant addiction — category page.

   Structural: parent of /what-we-treat/stimulant-addiction/methamphetamine/,
   which was 404ing while the nav and that child pointed at it.

   Stimulants appear on 85 of 571 Buena Vista calls (14.9% declarative) — meth
   70, cocaine/crack 17, adderall or generic stimulant 4. The largest substance
   category here after alcohol.

   THE KEY FACT, and the mirror of the opioid page: stimulants on their own
   admit straight to residential. There is no separate medical detox stage
   unless opioids or alcohol are also present. Do not restructure to match the
   opioid flow — admissions is explicit about this and getting it wrong sends
   people expecting an admission they will not get.
----------------------------------------------------------------------------- */
import Layout from '../../../layouts/Layout.astro';
import TopBar from '../../../components/TopBar.astro';
import Nav from '../../../components/Nav.astro';
import HubHero from '../../../components/hub/HubHero.astro';
import HubCards from '../../../components/hub/HubCards.astro';
import StimulantPathway from '../../../components/categories/StimulantPathway.astro';
import Testimonials from '../../../components/Testimonials.astro';
import VerifySection from '../../../components/VerifySection.astro';
import FinalCTA from '../../../components/FinalCTA.astro';

const title = 'Stimulant Addiction Treatment in Chandler, AZ | Buena Vista Health & Recovery';
const description =
  'Residential treatment for methamphetamine, cocaine and other stimulants in Chandler, AZ, with medical detox when opioids or alcohol are also involved. Call (888) 362-5576.';

const substances = [
  { label: 'Methamphetamine', tag: 'Most common', desc: 'The stimulant we see most. Usually admits straight into residential, with the first days given over to sleep and the comedown treated as part of the work.', href: '/what-we-treat/stimulant-addiction/methamphetamine/' },
  { label: 'Cocaine & crack', desc: 'Same pathway as meth in most cases, and frequently present alongside alcohol — which does change whether a detox is needed first.' },
  { label: 'Prescription stimulants', desc: 'Adderall and similar, whether prescribed originally or not. Worth raising early so a psychiatrist can review it as part of your assessment.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Stimulant Addiction Treatment in Chandler, AZ',
  description,
  url: 'https://buenavistarecovery.com/what-we-treat/stimulant-addiction/',
  about: { '@type': 'MedicalCondition', name: 'Stimulant Use Disorder', alternateName: ['Meth addiction', 'Cocaine addiction'] },
  provider: {
    '@type': 'MedicalClinic',
    name: 'Buena Vista Health & Recovery Centers — Chandler',
    telephone: '+1-888-362-5576',
    address: { '@type': 'PostalAddress', streetAddress: '3033 S Arizona Ave', addressLocality: 'Chandler', addressRegion: 'AZ', postalCode: '85286', addressCountry: 'US' },
  },
};
---
<Layout title={title} description={description}>
  <TopBar /><Nav />
  <HubHero
    eyebrow="Stimulant addiction · Chandler, Arizona"
    title="With stimulants, the hard part comes after you stop."
    intro="Putting it down is rarely the difficulty. The week that follows — the exhaustion, the flatness, the wanting — is what sends people back, and it is a great deal easier somewhere with a bed and people who understand it."
    points={['Residential treatment, often starting the same week','Detox first when opioids or alcohol are also involved','Sleep treated as part of recovery, not an inconvenience','A psychiatrist available for the low that follows']}
    image="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Conversation%20lounge%20with%20patterned%20armchairs,%20area%20rug,%20and%20kitchenette%20backdrop.png"
    alt="A conversation lounge with patterned armchairs"
    caption="Somewhere quiet for the week that matters most."
  />
  <StimulantPathway />
  <HubCards eyebrow="What this covers" title="Stimulants we treat" intro="Using something else alongside is the norm, and it is planned for from the first call." items={substances} />
  <Testimonials /><VerifySection />
  <FinalCTA />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Layout>
