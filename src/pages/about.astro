---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';

import OurTeam from '../components/OurTeam.astro';
import SpaceBuilt from '../components/SpaceBuilt.astro';
import FacilityGallery from '../components/FacilityGallery.astro';
import Testimonials from '../components/Testimonials.astro';
import LocationSection from '../components/LocationSection.astro';
import FinalCTA from '../components/FinalCTA.astro';

import AboutHero from '../components/about/AboutHero.astro';
import OurStory from '../components/about/OurStory.astro';
import OurContinuum from '../components/about/OurContinuum.astro';

const title = 'About Buena Vista Health & Recovery Centers | Chandler, AZ';
const description = 'Buena Vista Health & Recovery Centers in Chandler, Arizona: medical detox and residential treatment, and the team behind it.';

// VERIFY before publishing: the exact ownership framing and which reopening
// dates to state publicly; and every name, title, credential and consent in the
// team section (the brief lists Director of Nursing as "Brianna" Ramirez while
// the site currently says "Breana" — one of the two is wrong).

// Organization schema supports E-E-A-T for a brand/trust page. Person schema
// for named leadership is deliberately omitted until names are confirmed.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: 'Buena Vista Health & Recovery Centers',
  description,
  url: 'https://buenavistarecovery.com/about',
  logo: '/Asset/stock%20photo/Logo%20Buena%20Vista.svg',
  telephone: '+1-888-362-5576',
  /* medicalSpecialty is an ENUMERATION, not free text. "Addiction Medicine" is
     not a member, which is what the schema validator rejects. Psychiatric is
     the closest valid term for substance use and co-occurring mental health
     care, and is what behavioral health facilities are normally typed as.
     The human-readable specialism is carried in `description`, not here. */
  medicalSpecialty: 'https://schema.org/Psychiatric',
  // Chandler is the only facility, and the only address published in
  // structured data.
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3033 S Arizona Ave',
    addressLocality: 'Chandler',
    addressRegion: 'AZ',
    postalCode: '85286',
    addressCountry: 'US',
  },
};
---
<Layout title={title} description={description}>
  <TopBar />
  <Nav />

  <AboutHero />
  <OurStory />

  {/* BREATHER */}
  <FacilityGallery />

  {/* The people. Trust on a treatment site is built on faces. */}
  <OurTeam />

  <OurContinuum />

  {/* The environment — the non-institutional promise, shown not claimed */}
  <SpaceBuilt />

  {/* BREATHER */}
  <Testimonials />

  <LocationSection />

  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
