---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  /** Keeps a page out of search results — used for pages awaiting sign-off. */
  noindex?: boolean;
}
const {
  title = 'Buena Vista Health & Recovery Centers | Chandler, AZ',
  description = 'Honest, structured addiction treatment in Arizona. Medically supervised detox and residential treatment at our Chandler, AZ facility. Call (888) 362-5576.',
  noindex = false
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,400&family=Source+Sans+3:wght@300..700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="font-body antialiased">
    <slot />
  </body>
</html>

<script>
  // On mobile, the insurance form lives in its own section after the FAQ
  // (#verify-mobile) instead of the Hero (#verify, desktop only). Redirect
  // any #verify links to it below the lg breakpoint; desktop is unaffected.
  document.addEventListener('click', (e) => {
    if (window.innerWidth >= 1024) return;
    const link = (e.target as HTMLElement).closest('a[href="#verify"]');
    if (!link) return;
    const mobileTarget = document.getElementById('verify-mobile');
    if (!mobileTarget) return;
    e.preventDefault();
    mobileTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
