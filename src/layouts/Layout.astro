---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Buena Vista Health & Recovery Centers | Chandler, AZ',
  description = 'Honest, structured addiction treatment in Arizona. Detox, residential, IOP, and outpatient programs in Chandler, AZ. Call (888) 362-5576.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="font-body antialiased">
    <slot />
  </body>
</html>

<script>
  // On mobile, the insurance form lives in its own section after the FAQ
  // (#verify-mobile) instead of the Hero (#verify, desktop only). Redirect
  // any #verify links to it below the lg breakpoint; desktop is unaffected.
  document.addEventListener('click', (e) => {
    if (window.innerWidth >= 1024) return;
    const link = (e.target as HTMLElement).closest('a[href="#verify"]');
    if (!link) return;
    const mobileTarget = document.getElementById('verify-mobile');
    if (!mobileTarget) return;
    e.preventDefault();
    mobileTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
