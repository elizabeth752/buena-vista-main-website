---
import '../styles/global.css';
import { organization, breadcrumbs } from '../data/schema';
interface Props {
  title?: string;
  description?: string;
  /** Keeps a page out of search results — used for pages awaiting sign-off. */
  noindex?: boolean;
  /** Social share image, site-root relative. Defaults to the atrium shot. */
  ogImage?: string;
  /** 'article' on blog posts so the published/author tags mean something. */
  ogType?: 'website' | 'article';
}
const {
  title = 'Buena Vista Health & Recovery Centers | Chandler, AZ',
  description = 'Honest, structured addiction treatment in Arizona. Medically supervised detox and residential treatment at our Chandler, AZ facility.',
  noindex = false,
  ogImage = '/og-default.jpg',
  ogType = 'website'
} = Astro.props;

/* Canonical. Astro.url.pathname already carries the trailing slash the build
   emits, and vercel.json sets trailingSlash: true, so the two agree. Built
   without a query string on purpose: every ?utm_ variant must fold into one
   canonical URL or the migration splits its own equity. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

/* Organisation on every page under one @id, plus the breadcrumb trail. Pages
   add their own MedicalWebPage / FAQPage / BlogPosting nodes on top. */
const crumbs = breadcrumbs(Astro.url.pathname);
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': crumbs ? [organization, crumbs] : [organization],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Google Tag Manager — container GTM-N9GP4KF, the same one the legacy
        WordPress site ran. Placed as high in <head> as the charset and viewport
        allow, per Google's install instructions. `is:inline` keeps Astro from
        bundling it, which would delay the container and break the snippet
        Google gives you.

        WHAT THIS CONTAINER CARRIES (v30, 77 tags): GA4 G-85BKQVLVE7, Google Ads
        AW-860469019 with ten conversion labels plus AW-6088253076, a Facebook
        pixel firing Lead, Bing UET, CallRail (a second call-tracking system
        running alongside CTM), a dead UA property, and the CTM tags that do the
        dynamic number swap.

        ⚠ ONE TAG SWEEPS EVERY URL QUERY PARAMETER into enhanced_conversion_data
        and ships it to Google Ads. On the old WordPress site that was a direct
        PHI path. This site is built so nothing sensitive ever reaches a URL —
        see the note in InsuranceForm.astro — so the tag has far less to grab
        here, but it is still the first thing to fix in the container itself.
        Raised with Elizabeth on 2026-09-21. */}
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-N9GP4KF');</script>

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {/* SVG first for anything modern; the PNG covers the rest. Both are the
       gold mark on transparency — the old navy plate read as a dark block
       in a light tab. /favicon.ico carries the same PNG bytes because
       browsers request that path unprompted, and what was there was the
       Astro starter logo. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <meta name="theme-color" content="#0F2E3D" />

    {/* Open Graph and Twitter. Without these, every share of this site — and
        every LLM crawler that reads them — falls back to a bare URL. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Buena Vista Health & Recovery Centers" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {/* FONTS ARE SELF-HOSTED. They used to come from fonts.googleapis.com, which
        cost two DNS/TLS handshakes and a chained round trip: the CSS request had
        to resolve (301ms) before the browser even learned the woff2 URLs, which
        then came from a third origin (854ms). PageSpeed measured that chain as
        the critical path on 2026-09-21, with the page at LCP 11.1s.

        Serving them from our own origin removes both handshakes, and the
        @font-face rules are inlined here so there is no stylesheet request at
        all. The two latin faces are preloaded because they are the only ones an
        English page actually pulls; the latin-ext, italic and other slices stay
        gated behind unicode-range and cost nothing until something needs them.

        To update: re-run the fetch against the Google Fonts css2 URL with a
        modern UA, keep the latin slices, and drop the files in public/Fonts/gf.
        The family names must stay exactly 'Newsreader' and 'Source Sans 3' to
        match --font-display and --font-body in global.css. */}
    {/* PageSpeed flagged these as preconnect candidates on 2026-09-21, worth
        320-400ms of LCP between them. They are all pulled in by GTM, so the
        browser otherwise does not learn about them until the container has
        parsed and run. Kept to the three PSI named — more than about four
        preconnects starts costing more than it saves. */}
    <link rel="preconnect" href="https://218503.tctm.co" crossorigin />
    <link rel="preconnect" href="https://8ab0a26cb0027939bcf5-49c99c3c0c9c98b3365b710757036e1b.ssl.cf5.rackcdn.com" crossorigin />
    <link rel="preconnect" href="https://leads-api.gonorth.io" crossorigin />

    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/Fonts/gf/newsreader-normal-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/Fonts/gf/source-sans-3-normal-latin.woff2" />
    <style is:inline>
      @font-face{font-family:'Newsreader';font-style:italic;font-weight:400;font-display:swap;src:url('/Fonts/gf/newsreader-italic-latin-ext.woff2') format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;}
      @font-face{font-family:'Newsreader';font-style:italic;font-weight:400;font-display:swap;src:url('/Fonts/gf/newsreader-italic-latin.woff2') format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
      @font-face{font-family:'Newsreader';font-style:normal;font-weight:300 600;font-display:swap;src:url('/Fonts/gf/newsreader-normal-latin-ext.woff2') format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;}
      @font-face{font-family:'Newsreader';font-style:normal;font-weight:300 600;font-display:swap;src:url('/Fonts/gf/newsreader-normal-latin.woff2') format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
      @font-face{font-family:'Source Sans 3';font-style:normal;font-weight:300 700;font-display:swap;src:url('/Fonts/gf/source-sans-3-normal-latin-ext.woff2') format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;}
      @font-face{font-family:'Source Sans 3';font-style:normal;font-weight:300 700;font-display:swap;src:url('/Fonts/gf/source-sans-3-normal-latin.woff2') format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
    </style>
    <title>{title}</title>
  </head>
  <body class="font-body antialiased">
    {/* GTM noscript fallback. Must be the first thing inside <body>. */}
    <noscript is:inline><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N9GP4KF"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
  </body>
</html>

<script>
  // On mobile, the insurance form lives in its own section after the FAQ
  // (#verify-mobile) instead of the Hero (#verify, desktop only). Redirect
  // any #verify links to it below the lg breakpoint; desktop is unaffected.
  document.addEventListener('click', (e) => {
    if (window.innerWidth >= 1024) return;
    const link = (e.target as HTMLElement).closest('a[href="#verify"]');
    if (!link) return;
    const mobileTarget = document.getElementById('verify-mobile');
    if (!mobileTarget) return;
    e.preventDefault();
    mobileTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
