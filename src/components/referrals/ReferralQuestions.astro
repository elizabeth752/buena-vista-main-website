---
const faqs = [
  { q: 'How quickly can you take a referral?', a: "When a bed is open and coverage is confirmed, the same day. Bed status changes daily, so a call gives you a current answer rather than an assumption — and if we are full we will say so immediately rather than holding your client in limbo." },
  { q: 'What information do you need from me?', a: "Name, date of birth, insurance plan and member ID, the substance involved and last use, current medications, and anything clinically relevant. A discharge summary is useful where you have one, but its absence will not hold anything up." },
  { q: 'Do you accept Medicaid referrals?', a: "Yes. Access covers detox and residential treatment, and Banner University Family Care is in network with us today. Further plan contracts are being reinstated since the Chandler facility reopened, so it is worth checking the specific plan with us on the call." },
  { q: 'Can you take someone straight from a hospital or emergency department?', a: "Yes, and that is a common route in. Tell us the discharge timing at the start of the call so we can work to it, and we can liaise directly with the case manager or discharge planner to coordinate." },
  { q: 'What about clients with probation or court obligations?', a: "Common and workable. Let us know the requirements at the point of referral — attendance documentation, programme length, reporting — and the case manager can support those while your client is with us." },
  { q: 'My client is on methadone or buprenorphine. Can you take them?', a: "Flag it at the point of referral with the dose and duration. Our physicians review maintenance medication as part of the assessment and plan around it, and settling that before arrival avoids problems on the day." },
  { q: 'Do you provide transport?', a: "Ask about airport pickup for anyone flying in. For other arrangements, raise it on the call and we will work through the practicalities with you." },
  { q: 'What if this is not the right level of care?', a: "We will tell you inside the first call and suggest where else to look. Outpatient and partial hospitalisation are handled by other programmes in Arizona, and we would rather redirect you quickly than take a placement that will not hold." },
];
---
<section id="referral-faq" class="bg-cream py-[70px]">
  <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8">
    <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
      <span class="w-6 h-px bg-gold inline-block"></span>
      Straight answers
    </p>
    <h2 class="font-display text-charcoal mb-10">Questions from referrers</h2>

    <div class="divide-y divide-cream-soft border-t border-b border-cream-soft">
      {faqs.map(f => (
        <details class="group py-5">
          <summary class="flex items-start justify-between gap-6 cursor-pointer">
            <h3 class="font-body font-semibold text-charcoal text-[18px] leading-[28px]">{f.q}</h3>
            <span class="shrink-0 mt-1 text-teal">
              <svg class="faq-plus w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
              </svg>
              <svg class="faq-minus w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" d="M5 12h14"/>
              </svg>
            </span>
          </summary>
          <p class="font-body text-charcoal text-[16px] leading-[27px] mt-4 pr-10">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
