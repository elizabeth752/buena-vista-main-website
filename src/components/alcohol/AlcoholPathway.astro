---
/* The shape of a stay, end to end. Lengths follow the client wiki: detox 5-7
   days commercial / 3 days Medicaid, residential 25-30 commercial / 30-45
   Medicaid. Stated as ranges, since what a plan authorises varies. */
const steps = [
  {
    n: '01',
    h: 'The call',
    tag: '10–15 minutes',
    p: 'A short, plain conversation about how much, how often, and how long — plus anything medical we should know. We check your coverage while you are on the line. Nobody is assessed on whether they sound serious enough.',
  },
  {
    n: '02',
    h: 'Medical detox',
    tag: 'Around a week',
    p: 'Alcohol usually needs the longer end of a detox stay, often close to a full week, though the exact length depends on your history and your plan. Nursing on site 24/7, physician oversight, and medication to keep you comfortable.',
  },
  {
    n: '03',
    h: 'Residential treatment',
    tag: 'Around 30 days',
    p: 'Once your body is steady, the actual work starts: group therapy twice a day, one-to-one sessions with your therapist, and a case manager building the plan for afterwards. Same building — no moving facilities mid-stay.',
  },
  {
    n: '04',
    h: 'What comes after',
    tag: 'Planned before you leave',
    p: 'Discharge planning, continuing care, alumni support, and referrals to whatever fits your life next — outpatient care, recovery meetings, or somewhere to live while you settle.',
  },
];
---
<section id="pathway" class="bg-sage-tint py-[70px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What happens
      </p>
      <h2 class="font-display text-charcoal mb-5">From the first call to going home</h2>
      <p class="font-body text-charcoal text-[18px] leading-[30px]">
        Detox and residential care happen under one roof, so the hardest part is the phone call rather than the logistics.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map(s => (
        <div class="bg-white rounded-xl p-7 border border-cream-soft">
          <p class="font-display text-gold text-[32px] leading-none mb-4">{s.n}</p>
          <h3 class="font-display text-[22px] leading-[28px] text-navy mb-2">{s.h}</h3>
          <span class="inline-block font-body text-xs font-bold uppercase tracking-wide text-gold bg-gold/10 rounded-full px-3 py-1.5 mb-4">{s.tag}</span>
          <p class="font-body text-charcoal text-[16px] leading-[26px]">{s.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>
