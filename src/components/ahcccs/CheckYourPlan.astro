---
/* AHCCCS is delivered through several managed-care plans and our contracts are
   still being reinstated after the Chandler reopening — Banner University
   Family Care is confirmed in network, others are in progress. Rather than
   publish a plan-by-plan table that goes stale (and reads as a rejection list),
   this section names what we know and routes everything else to a two-minute
   check. Update the confirmed list as contracts land. */
const steps = [
  { n: '01', h: 'Tell us the name on your card', p: 'Access is delivered through several health plans and each one contracts separately. The plan name on your card is all we need to start.' },
  { n: '02', h: 'We check it while you wait', p: 'It takes a couple of minutes, it is free, and it commits you to nothing. You will get a straight answer rather than a maybe.' },
  { n: '03', h: 'You leave the call with a plan', p: 'If we are in network, we talk about beds and timing. If your plan is one we are still working on, we help you find a programme that takes it.' },
];
---
<section id="check-plan" class="bg-sage-tint py-[70px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 items-start">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Your plan specifically
        </p>
        <h2 class="font-display text-charcoal mb-5">Which Access plans we take</h2>

        <div class="space-y-5 font-body text-charcoal text-[17px] leading-[29px] mb-8">
          <p>
            <strong class="font-bold">Banner University Family Care is in network with us today.</strong> If that is the plan on your card, you are covered here and we can talk about a bed straight away.
          </p>
          <p>
            Our Chandler facility reopened recently under new ownership, and we are steadily reinstating the rest of our health-plan contracts. Several are in progress right now, which is why a live check beats any list we could print here.
          </p>
        </div>

        <div class="bg-white border-l-2 border-gold rounded-r-xl p-6">
          <p class="font-body text-charcoal text-[16px] leading-[27px]">
            Whatever your plan turns out to be, <strong class="font-bold">call us anyway</strong>. Helping people find the right programme — here or elsewhere in Arizona — is a normal part of what our admissions team does, and you will not be left to work it out alone.
          </p>
        </div>
      </div>

      <div>
        <div class="space-y-5 mb-8">
          {steps.map(s => (
            <div class="bg-white rounded-xl p-6 border border-cream-soft flex gap-5">
              <p class="font-display text-gold text-[28px] leading-none shrink-0">{s.n}</p>
              <div>
                <h3 class="font-display text-[21px] leading-[27px] text-navy mb-2">{s.h}</h3>
                <p class="font-body text-charcoal text-[16px] leading-[26px]">{s.p}</p>
              </div>
            </div>
          ))}
        </div>

        <a href="tel:8883625576" class="w-full inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          <span class="tel-number">Call (888) 362-5576</span>
        </a>
      </div>

    </div>
  </div>
</section>
