---
const timeline = [
  {
    when: 'The first call',
    title: 'A real person, then a short assessment',
    desc: 'Ten to twenty minutes about what you have been using, when you last used, your medical history, and any medications. We can do this even if you are using right now — being honest helps us keep you safe.',
  },
  {
    when: 'Before you arrive',
    title: 'A provider reviews it and we hold a bed',
    desc: 'A medical provider confirms detox is safe for your situation, we check your benefits, and we confirm a bed and a time. If getting here is the problem, say so and we can often arrange a ride locally.',
  },
  {
    when: 'Arrival',
    title: 'Settling into your own room',
    desc: 'A private room with a private bathroom. Detox rooms are kept simple and calm on purpose; the TVs and the larger living space come with the residential step afterwards.',
  },
  {
    when: 'The first days',
    title: 'Rest, medication, and being checked on',
    desc: 'This part is mostly about being cared for while your body does hard work. Nurses come by around the clock, comfort medication eases the symptoms, and meals are brought to you.',
  },
  {
    when: 'As you steady',
    title: 'Groups, when you feel up to them',
    desc: 'There is daily group support for people who want it. Nobody is dragged out of bed on day two — the early days are for stabilizing, and the rest comes when you are ready.',
  },
  {
    when: 'Around day five to seven',
    title: 'Deciding what comes next',
    desc: 'A case manager has been planning this with you since early on. For most people the next step is residential treatment, in the same building with the same team.',
  },
];

// The two logistics questions callers ask most. They sit apart from the
// timeline on purpose, but as a deliberate pair — centered, with a gold rule
// across the top — rather than two cards left floating at the end.
const logistics = [
  {
    title: 'Phones during detox',
    desc: 'Phones are not permitted while you are in detox. It is a short window, and it is there so those first days belong to your safety and rest. Phone access starts when you move into residential, every evening from 4:00 to 9:00 PM.',
    d: 'M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3',
  },
  {
    title: 'Smoking and vaping',
    desc: 'Allowed on scheduled breaks, as long as what you bring is brand new and still sealed. Nobody is going to ask you to quit nicotine in the same week you are detoxing from something far harder.',
    d: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z',
  },
];
---
<section id="what-to-expect" class="bg-white py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-14 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What to expect
      </p>
      <h2 class="font-display text-charcoal mb-4">
        What medical detox is like, day by day
      </h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] max-w-2xl">
        Most people picture something cold and clinical. Here is what really happens, so there are no surprises when you walk in.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-x-14 gap-y-2 max-w-5xl">
      {timeline.map((item, i) => (
        <div class={`flex gap-6 py-6 ${i < timeline.length - 1 ? 'border-b border-cream-soft' : ''}`}>
          <div class="shrink-0 w-10 h-10 rounded-full bg-cream flex items-center justify-center font-body text-[16px] font-bold text-navy">
            {i + 1}
          </div>
          <div>
            <p class="font-body text-xs font-bold uppercase tracking-[0.14em] text-gold mb-1.5">{item.when}</p>
            <h3 class="font-display text-xl text-charcoal mb-2">{item.title}</h3>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 max-w-4xl mx-auto">
      <p class="text-center font-body text-muted text-[13px] font-bold tracking-[0.14em] uppercase mb-6">
        The two things everybody asks about
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        {logistics.map(item => (
          <div class="bg-cream rounded-xl border border-cream-soft border-t-4 border-t-gold p-8 text-center">
            <div class="w-12 h-12 rounded-full bg-gold/15 flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
              </svg>
            </div>
            <h3 class="font-display text-xl text-charcoal mb-2">{item.title}</h3>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
