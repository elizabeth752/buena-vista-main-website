---
import Horizon from '../Horizon.astro';

/* STANDARD HERO SHAPE (agreed 2026-09-08, rolls out one page at a time):
     1. H1 carries the keyword. Nothing else goes in it.
     2. The emotional promise sits directly above the bullets, where eyes land,
        not in a subtitle nobody reads.
     3. No subtitle paragraph.
     4. Every bullet gets its own icon.
   Detox is the point of maximum fear and maximum medical risk, so the bullets
   lead with safety, then speed. Never fear-based, never "pain-free". */
const reassurances = [
  {
    text: 'Nurses on site 24 hours a day, with physician oversight',
    // shield-check
    d: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
  {
    text: 'Comfort medication so you are not white-knuckling withdrawal',
    // beaker
    d: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c.251.023.501.05.75.082M9.75 3.104a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.186c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15.75a9.065 9.065 0 00-6.23-.657L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
  },
  {
    text: 'Your own room and your own bathroom, not a shared ward',
    // home / door
    d: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75',
  },
  {
    text: 'Same-day admission is often possible when a bed is open',
    // clock
    d: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    text: 'Answered any hour, and the assessment takes 10 to 20 minutes',
    // phone
    d: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z',
  },
];
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,500px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Medically supervised detox
        </p>

        <h1 class="font-display text-navy mb-6">
          Medical Detox in Chandler, Arizona
        </h1>

        {/* The promise, moved out of the subtitle and parked immediately above
             the bullets, which is where people actually start reading. */}
        <p class="font-display text-navy text-[26px] leading-[34px] md:text-[30px] md:leading-[39px] border-l-[3px] border-gold pl-5 mb-8 max-w-xl">
          You will be safe, and you will be looked after.
        </p>

        <ul class="space-y-4 mb-9">
          {reassurances.map(item => (
            <li class="flex items-start gap-3.5 font-body text-charcoal text-[17px] leading-[29px]">
              <span class="w-9 h-9 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-[19px] h-[19px] text-teal" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
                </svg>
              </span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="tel:8883625576"
            class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Talk to someone now
          </a>
          <a
            href="#verify"
            class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body"
          >
            Check my insurance
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Intimate%20fireside%20lounge%20with%20four%20armchairs%20and%20built-in%20fireplace.webp"
            alt="A fireside lounge at Buena Vista in Chandler, with four armchairs around a low table and a lit built-in fireplace"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          width="1600" height="966" />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          Detox here happens in a residential setting rather than a hospital ward, with nursing on site around the clock.
        </p>
      </div>

    </div>
  </div>
</section>
