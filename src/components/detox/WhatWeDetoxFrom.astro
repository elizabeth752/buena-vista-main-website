---
// Only substances confirmed in the admissions calls. Stimulants are handled
// honestly rather than implying a medical "meth detox" that isn't clinically
// standard — the brief is specific about this.
//
// Card bodies are bullets rather than paragraphs: each card answers "what is
// this withdrawal like" and "what do you do about it", which is what callers
// are actually asking.
const substances = [
  {
    name: 'Alcohol detox',
    lead: 'Shakes, sweats, and the fear of a seizure.',
    points: [
      'Detox here is nursed around the clock from the first day',
      'One of the few withdrawals that can be genuinely dangerous alone',
      'Watched around the clock for seizure and delirium risk',
      'Comfort medication from the first day, not day three',
    ],
  },
  {
    name: 'Opioid and fentanyl detox',
    lead: 'Fentanyl, heroin, oxycodone, Percocet, and other prescription painkillers.',
    points: [
      'Rarely life-threatening, but punishing without help',
      'Medication makes an enormous difference to how you get through it',
      'Tell us on the phone if you are on methadone or buprenorphine',
      'Residential treatment continues here afterwards, same team',
    ],
  },
  {
    name: 'Benzodiazepine detox',
    lead: 'Xanax, Klonopin, Ativan, and others.',
    points: [
      'Like alcohol, this one can turn serious quickly',
      'Tapered under supervision rather than alone at home',
      'Vital signs tracked through the night',
      'Bring your current prescriptions so our providers can plan',
    ],
  },
  {
    name: 'Kratom detox',
    lead: 'More physically habit-forming than most people expect.',
    points: [
      'Managed with comfort medication, the same as any other withdrawal',
      'People are often surprised how dependent they have become',
      'No judgment about it here, from anyone on staff',
    ],
  },
];
---
<section id="what-we-detox-from" class="bg-white py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-12 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What we detox from
      </p>
      <h2 class="font-display text-charcoal mb-4">
        Alcohol, opioid, and benzodiazepine detox in Arizona
      </h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] max-w-2xl">
        You will not shock anybody on our admissions line. Whatever brought you here, we have seen it.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {substances.map(s => (
        <div class="bg-cream rounded-xl p-8 border border-cream-soft flex flex-col h-full">
          <h3 class="font-display text-2xl text-charcoal mb-2">{s.name}</h3>
          <p class="font-body text-muted text-[16px] leading-[26px] mb-5">{s.lead}</p>
          <ul class="space-y-2.5">
            {s.points.map(p => (
              <li class="flex items-start gap-3 font-body text-charcoal text-[16px] leading-[26px]">
                <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 mt-[10px]"></span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>
