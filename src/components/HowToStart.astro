---
const steps = [
  {
    num: '01',
    title: 'Make One Call',
    desc: 'That\'s genuinely all we\'re asking. Call (888) 362-5576 — anytime, day or night. A real person answers. You don\'t need to have the right words. You don\'t need to be certain. You just need to pick up the phone.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-9 h-9 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M2 6.5A1.5 1.5 0 013.5 5h2.097A1.5 1.5 0 017.1 5.63l.74 4.435a1.5 1.5 0 01-.54 1.59l-1.126.563a11.037 11.037 0 006.105 6.105l.563-1.126a1.5 1.5 0 011.59-.54l4.435.74A1.5 1.5 0 0120.5 18.903V21a1.5 1.5 0 01-1.5 1.5h-2C8.82 22.5 1.5 15.18 1.5 6V4A1.5 1.5 0 013 2.5"/></svg>`,
  },
  {
    num: '02',
    title: 'We Handle the Insurance',
    desc: 'While you\'re on the phone with us, we run an instant benefits check through our billing partner. No forms to fill out alone, no confusing back-and-forth. We find out what your plan covers and we tell you the truth — all of it.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-9 h-9 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>`,
  },
  {
    num: '03',
    title: 'Meet Your Clinical Team',
    desc: 'A licensed clinician does a full assessment — your history, your goals, what\'s actually going on beneath the surface. From there, we build a treatment plan around you specifically. Not a template. Not a standard protocol. You.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-9 h-9 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>`,
  },
];
---
<section class="bg-white py-[50px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center justify-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        Getting Started
        <span class="w-6 h-px bg-gold inline-block"></span>
      </p>
      <h2 class="font-display text-black mb-4">
        Getting Connected Is Simpler Than You Think
      </h2>
      <p class="font-body text-black max-w-xl mx-auto text-base leading-relaxed">
        Most people who call us are admitted within 24 hours. The first step is almost always the hardest one — and it's just a phone call.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {steps.map((step, i) => (
        <div class={`relative flex flex-col items-center text-center ${i < steps.length - 1 ? 'pb-6 border-b border-dashed border-gold/50 md:pb-0 md:border-b-0' : ''}`}>
          <div class="w-20 h-20 rounded-full bg-navy-deep flex items-center justify-center mb-6 shadow-lg ring-4 ring-gold/20">
            <Fragment set:html={step.icon} />
          </div>
          <p class="text-gold font-body text-xs font-bold tracking-widest uppercase mb-2">Step {step.num}</p>
          <h3 class="font-display text-2xl text-black mb-3">{step.title}</h3>
          <p class="font-body text-black text-sm leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 bg-cream rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-display text-2xl text-black mb-1">Not ready to call yet? That's okay too.</p>
        <p class="font-body text-black text-sm">Submit the form above and we'll reach out — on your timeline, with zero pressure.</p>
      </div>
      <a href="tel:8883625576" class="shrink-0 bg-navy hover:bg-navy-mid text-white font-bold px-8 py-4 rounded transition-colors font-body tracking-wide whitespace-nowrap">
        Call (888) 362-5576
      </a>
    </div>
  </div>
</section>
