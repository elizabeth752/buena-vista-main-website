---
import Horizon from '../Horizon.astro';
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,470px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Length of stay
        </p>

        <h1 class="font-display text-navy mb-6">
          How long will I be here?
        </h1>

        <p class="font-body text-charcoal text-[20px] leading-[33px] max-w-xl mb-8">
          The short answer: about a week for detox, and about a month for residential treatment. The longer answer depends on what you have been using, how your body responds, and what your plan authorises — and you will know the shape of it before you arrive rather than afterwards.
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mb-9 max-w-xl">
          <div class="bg-white rounded-xl p-6 border border-cream-soft shadow-sm">
            <p class="font-body text-gold text-xs font-bold tracking-[0.14em] uppercase mb-2">Medical detox</p>
            <p class="font-display text-navy text-[30px] leading-[36px] mb-1">4–7 days</p>
            <p class="font-body text-muted text-[15px] leading-[24px]">Often the full week for alcohol</p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-cream-soft shadow-sm">
            <p class="font-body text-gold text-xs font-bold tracking-[0.14em] uppercase mb-2">Residential</p>
            <p class="font-display text-navy text-[30px] leading-[36px] mb-1">30 days</p>
            <p class="font-body text-muted text-[15px] leading-[24px]">Sometimes longer where it helps</p>
          </div>
        </div>

        <div class="border-l-2 border-gold pl-5 mb-9 max-w-xl">
          <p class="font-body text-charcoal text-[16px] leading-[26px]">
            <strong class="font-bold">Your stay is voluntary from the first day to the last.</strong> Choosing to be here is one of the strongest things going for you, and it stays your choice throughout. The length that gets talked about is a recommendation, not a sentence.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Ask what yours would look like
          </a>
          <a href="/admissions/" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            How admission works
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Fireplace%20gathering%20area%20with%20high-back%20chairs,%20sofas,%20and%20table%20lamps.png"
            alt="A fireplace gathering area with high-back chairs, sofas and table lamps"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          Long enough to get somewhere. Short enough to picture.
        </p>
      </div>

    </div>
  </div>
</section>
