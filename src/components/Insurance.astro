---
// Shared coverage section. Defaults render the homepage version with carrier
// logos. Program pages can pass showLogos={false} to keep the visual break
// without asserting a specific in-network payer list (see the residential
// brief's HIGH-VERIFY note on payer status).
interface Props {
  heading?: string;
  intro?: string;
  showLogos?: boolean;
  bg?: string;
}

const insurers = [
  { name: 'Aetna', logo: '/Asset/Insurances/Aetna.svg' },
  { name: 'Blue Cross Blue Shield', logo: '/Asset/Insurances/BCBS.svg' },
  { name: 'Cigna', logo: '/Asset/Insurances/Cigna.svg' },
  { name: 'Humana', logo: '/Asset/Insurances/Humana.svg' },
  { name: 'Medicare', logo: '/Asset/Insurances/Medicare.svg' },
  { name: 'UnitedHealthcare', logo: '/Asset/Insurances/United%20Healthcare.svg' },
];

const {
  heading = 'Most Plans Accepted & Verified in Minutes',
  intro = 'We work with most major insurance carriers to make treatment accessible. Use our online form or call us to verify your benefits at no cost — and with no obligation to commit.',
  showLogos = true,
  bg = 'bg-cream',
} = Astro.props;
---
<section id="insurance" class={`${bg} py-[50px]`}>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="mb-[30px] sm:mb-12 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        Coverage
      </p>
      <h2 class="font-display text-charcoal mb-4">
        {heading}
      </h2>
      <p class="font-body text-charcoal max-w-xl text-[17px] leading-[29px]">
        {intro}
      </p>
    </div>

    {showLogos && (
      <div class="flex flex-wrap justify-center items-center gap-3 sm:gap-8 mb-[30px] sm:mb-12">
        {insurers.map(ins => (
          <div class="flex items-center justify-center bg-white rounded-xl px-6 py-4 shadow-sm border border-cream-soft hover:shadow-md transition-shadow" style="min-width:120px; min-height:60px;">
            <img src={ins.logo} alt={ins.name} class="h-8 max-w-[110px] object-contain" />
          </div>
        ))}
      </div>
    )}

    <div>
      <a href="#verify" class="inline-block bg-teal hover:bg-teal-dark text-white font-bold px-9 py-4 rounded-lg transition-colors font-body tracking-wide">
        Verify your coverage
      </a>
    </div>
  </div>
</section>
