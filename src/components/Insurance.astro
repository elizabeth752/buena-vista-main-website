---
import InsuranceForm from './InsuranceForm.astro';

/* Coverage section. The form now sits inside it rather than sending people to
   an anchor elsewhere on the page — coverage is the single most-asked topic in
   the call export (insurance appears on ~1,650 calls), so the answer and the
   means of getting it belong together.

   ⚠ LOGO SET IS INCOMPLETE AND PARTLY WRONG. The repo ships six carrier logos:
   Aetna, BCBS, Cigna, Humana, UnitedHealthcare, Medicare. Two of those must NOT
   be shown:
     UnitedHealthcare — admissions states we are not currently in network
                        ("we're not currently in network with UnitedHealthcare")
     Medicare         — not accepted; the existing /insurance page says so
   And the logos that matter most are missing entirely. Banner University Family
   Care is the single most-mentioned payer (12.3% of calls) and the one agent-
   confirmed in-network plan, with no logo in the repo. Same for Mercy Care,
   Molina, Health Choice Arizona and Arizona Complete Health — together the
   majority of callers.

   So the commercial logos below sit under the soft, defensible claim "we work
   with most major carriers — we will check yours", NOT "we are in network with
   these". Swap to a hard claim only once the payer grid confirms it. */
interface Props {
  heading?: string;
  intro?: string;
  showLogos?: boolean;
  showForm?: boolean;
  bg?: string;
}

const insurers = [
  { name: 'Aetna', logo: '/Asset/Insurances/Aetna.svg' },
  { name: 'Blue Cross Blue Shield', logo: '/Asset/Insurances/BCBS.svg' },
  { name: 'Cigna', logo: '/Asset/Insurances/Cigna.svg' },
  { name: 'Humana', logo: '/Asset/Insurances/Humana.svg' },
];

const {
  heading = 'Does your insurance cover treatment?',
  intro = 'It is the first thing most people need to know, and it takes a few minutes to find out. We check your benefits at no cost, with nothing owed either way.',
  showLogos = true,
  showForm = true,
  bg = 'bg-cream',
} = Astro.props;
---
<section id="insurance" class={`${bg} py-[60px]`}>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_minmax(0,420px)] gap-12 lg:gap-16 items-start">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Coverage
        </p>
        <h2 class="font-display text-charcoal mb-4">{heading}</h2>
        <p class="font-body text-charcoal max-w-xl text-[17px] leading-[29px] mb-8">{intro}</p>

        <div class="bg-white border border-cream-soft rounded-xl p-6 mb-8 max-w-xl">
          <p class="font-body font-semibold text-charcoal text-[17px] leading-[27px] mb-2">
            On AHCCCS? Most of the people we care for are.
          </p>
          <p class="font-body text-charcoal text-[16px] leading-[26px]">
            Access covers medical detox and residential treatment, and
            <strong class="font-bold">Banner University Family Care is in network with us</strong>.
            Give us the plan name on your card and we will check it while you are on the phone.
          </p>
          <a href="/insurance/ahcccs-medicaid/" class="inline-block mt-3 font-body text-teal font-semibold text-[15px] hover:underline">
            More on AHCCCS &amp; Medicaid &rarr;
          </a>
        </div>

        {showLogos && (
          <div>
            <p class="font-body text-muted text-[13px] font-bold tracking-[0.12em] uppercase mb-4">
              We work with most major carriers
            </p>
            <div class="flex flex-wrap items-center gap-3">
              {insurers.map(ins => (
                <div class="flex items-center justify-center bg-white rounded-xl px-5 py-3 shadow-sm border border-cream-soft" style="min-width:112px; min-height:56px;">
                  <img src={ins.logo} alt={ins.name} class="h-7 max-w-[100px] object-contain" loading="lazy" />
                </div>
              ))}
              <div class="flex items-center justify-center bg-cream rounded-xl px-5 py-3 border border-dashed border-cream-soft" style="min-width:112px; min-height:56px;">
                <span class="font-body text-muted text-[14px] font-semibold text-center leading-[18px]">and more —<br />ask us</span>
              </div>
            </div>
          </div>
        )}
      </div>

      {showForm && <InsuranceForm id="verify-inline" />}
    </div>
  </div>
</section>
