---
import ConsentFields from './ConsentFields.astro';

interface Props {
  id?: string;
  class?: string;
  /* 'coverage' is the standard block on ~37 pages: it asks for carrier and
     policy ID so admissions can run a benefits check before calling back.

     'contact' asks for a name and a number and nothing else. The carrier and
     policy fields were never `required` even on the coverage form, but the
     heading, the button and the two insurance inputs made it READ as though
     they were, so anyone without insurance — or not ready to hand over a policy
     number — bounced. The client asked for this variant on 2026-09-21.

     Both post to the same /api/lead endpoint and the same CTM FormReactor.
     They stay separable in reporting because `paid_attribution[form_id]` is the
     form's `id`, so give this one a distinct id wherever it is used. */
  variant?: 'coverage' | 'contact';
}
const { id = 'verify', class: className = '', variant = 'coverage' } = Astro.props;
const isContact = variant === 'contact';
---
<div id={id} class={`bg-white rounded-xl shadow-2xl px-3 py-7 lg:p-7 text-charcoal ${className}`}>

  {/* Carrier list covers AHCCCS/Access plans as well as commercial ones.
       Access is the majority payer for this facility, and a form that only
       offered commercial carriers pushed most people to "Other / Not sure".
       Listing a plan here is a picker option, NOT a claim that we are in
       network with it — network status is confirmed on the call.

       Form heading + HIPAA badge as trust indicator.
       In-form headings are H5: Source Sans 3 600 · 22/29, not the display serif. */}
  <div class="flex flex-row items-center justify-between gap-3 mb-1">
    <h5 class="font-body font-semibold text-[22px] leading-[29px] text-charcoal">{isContact ? 'Have us call you' : 'Check your coverage now'}</h5>
    <img src="/Asset/Accreditations/HIPAA%20Compliant.svg" alt="HIPAA Compliant" class="h-9 shrink-0" loading="lazy" decoding="async" />
  </div>
  <p class="text-charcoal text-[16px] leading-[26px] font-body mb-5">
    {isContact
      ? 'Just a name and a number. Insurance details are not needed to talk to us.'
      : 'Takes less than a minute. No commitment required.'}
  </p>

  <form class={`space-y-4 verify-form verify-form-${id}`} method="POST" action="/api/lead" data-lead-form data-form-id={id}>
    <div class={`grid grid-cols-1 gap-3 lg:gap-4 ${isContact ? '' : 'sm:grid-cols-2'}`}>
      <div>
        <label class="block text-xs font-bold text-charcoal uppercase tracking-wide mb-1.5" for={`${id}-name`}>Your Name</label>
        <input id={`${id}-name`} name="caller_name" type="text" required autocomplete="name" placeholder="First and last name" class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm font-body focus:outline-none focus:ring-2 focus:ring-teal/40 focus:border-teal transition-colors" />
      </div>
      <div>
        <label class="block text-xs font-bold text-charcoal uppercase tracking-wide mb-1.5" for={`${id}-phone`}>Your Phone</label>
        <input id={`${id}-phone`} name="phone_number" type="tel" required autocomplete="tel" placeholder="(555) 000-0000" class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm font-body focus:outline-none focus:ring-2 focus:ring-teal/40 focus:border-teal transition-colors" />
      </div>
{!isContact && (<>
      <div>
        <label class="block text-xs font-bold text-charcoal uppercase tracking-wide mb-1.5" for={`${id}-insurance`}>Insurance Carrier</label>
        <select id={`${id}-insurance`} name="custom_fields[insurance_provider]" class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm font-body focus:outline-none focus:ring-2 focus:ring-teal/40 focus:border-teal transition-colors text-charcoal bg-white">
          <option value="">Select your carrier</option>
          <optgroup label="AHCCCS / Access plans">
            <option>Banner University Family Care</option>
            <option>Mercy Care</option>
            <option>Arizona Complete Health</option>
            <option>Health Choice Arizona</option>
            <option>Molina Healthcare</option>
            <option>AHCCCS &mdash; not sure which plan</option>
          </optgroup>
          <optgroup label="Commercial plans">
            <option>Aetna</option>
            <option>Blue Cross Blue Shield</option>
            <option>Cigna</option>
            <option>Humana</option>
            <option>UnitedHealthcare</option>
          </optgroup>
          <option>Other / Not sure</option>
          <option>I don't have insurance</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-bold text-charcoal uppercase tracking-wide mb-1.5" for={`${id}-policy`}>Membership Policy ID</label>
        <input id={`${id}-policy`} name="custom_fields[id]" type="text" autocomplete="off" placeholder="Policy ID" class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm font-body focus:outline-none focus:ring-2 focus:ring-teal/40 focus:border-teal transition-colors" />
      </div>
</>)}
    </div>
    <ConsentFields id={id} />

    <button type="submit" class="w-full bg-teal hover:bg-teal-dark text-white font-bold py-3.5 rounded-lg transition-colors font-body tracking-wide text-sm">
      {isContact ? 'Request a call' : 'Check my coverage'}
    </button>

    {/* Honeypot. Hidden from people, irresistible to form-fillers; api/lead.js
         discards anything that arrives with it filled. Not `display:none` —
         some bots skip what is obviously hidden — and tabindex/aria-hidden
         keep it out of the keyboard and screen-reader path. */}
    <div class="absolute w-px h-px -m-px overflow-hidden" aria-hidden="true">
      <label for={`${id}-company-website`}>Company website</label>
      <input id={`${id}-company-website`} name="company_website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {/* Filled by the script below. An empty attribution field costs a reporting
         dimension, not the lead, so none of them is required. */}
    <input type="hidden" name="rendered_at" value="" />
    <input type="hidden" name="paid_attribution[form_id]" value={id} />
    <input type="hidden" name="paid_attribution[gclid]" value="" />
    <input type="hidden" name="paid_attribution[campaign_id]" value="" />
    <input type="hidden" name="paid_attribution[adgroup_id]" value="" />
    <input type="hidden" name="paid_attribution[creative_id]" value="" />
    <input type="hidden" name="paid_attribution[source]" value="" />
    <input type="hidden" name="paid_attribution[medium]" value="" />
    <input type="hidden" name="paid_attribution[campaign]" value="" />
  </form>

  <p class="text-xs text-charcoal font-body mt-4 leading-relaxed">
    Confidential &middot; No pressure &middot; No spam
  </p>

</div>

<script>
  // Fills the hidden attribution fields on every lead form on the page (the
  // hero form on desktop, the standalone section on mobile).
  //
  // WHERE THE VALUES COME FROM. Google Ads ValueTrack writes campaignid,
  // adgroupid and creative onto the landing URL alongside gclid; utm_* is the
  // fallback for everything else. A visitor who arrives from an ad, wanders off
  // and comes back would otherwise lose the click id, so it is stashed in
  // sessionStorage on first sight and reused for the rest of the session.
  //
  // ATTRIBUTION ONLY — never the form's own answers. The policy ID and the
  // carrier are health information and must not be written to storage, a
  // dataLayer, or a query string. They travel in the POST body and nowhere else.
  const params = new URLSearchParams(window.location.search);

  function stash(key: string, value: string | null): string {
    try {
      if (value) sessionStorage.setItem(key, value);
      return value || sessionStorage.getItem(key) || '';
    } catch {
      return value || '';   // private mode / storage disabled
    }
  }

  const attribution: Record<string, string> = {
    'paid_attribution[gclid]': stash('bv_gclid', params.get('gclid')),
    'paid_attribution[campaign_id]': stash('bv_campaignid', params.get('campaignid') || params.get('campaign_id')),
    'paid_attribution[adgroup_id]': stash('bv_adgroupid', params.get('adgroupid') || params.get('adgroup_id')),
    'paid_attribution[creative_id]': stash('bv_creative', params.get('creative') || params.get('creative_id')),
    'paid_attribution[source]': stash('bv_source', params.get('utm_source')),
    'paid_attribution[medium]': stash('bv_medium', params.get('utm_medium')),
    'paid_attribution[campaign]': stash('bv_campaign', params.get('utm_campaign')),
  };

  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    for (const [name, value] of Object.entries(attribution)) {
      const field = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
      if (field && value) field.value = value;
    }

    // When the form was drawn, so the server can reject a submission returned
    // faster than a person could type it. Set here rather than server-side so a
    // cached page cannot carry a stale timestamp.
    const renderedAt = form.querySelector<HTMLInputElement>('input[name="rendered_at"]');
    if (renderedAt) renderedAt.value = String(Date.now());

    // Stop the double-submit that produces duplicate leads when someone taps
    // twice on a slow connection. Re-enabled on pageshow so a browser Back does
    // not leave a dead button behind.
    const label = form.querySelector<HTMLButtonElement>('button[type="submit"]')?.textContent ?? '';
    form.addEventListener('submit', () => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!button) return;
      button.disabled = true;
      button.textContent = 'Checking...';
    });
    window.addEventListener('pageshow', () => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!button) return;
      button.disabled = false;
      button.textContent = label;
    });
  });
</script>
