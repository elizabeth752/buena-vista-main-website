---
import Horizon from '../Horizon.astro';

/* Shared hero for the service-area pages.

   ⚠ THESE ARE NOT LOCATION PAGES. There is one facility, in Chandler. Every
   page using this component must:
     1. carry NO LocalBusiness/MedicalClinic schema and NO NAP for its city
     2. state plainly in the hero that the building is in Chandler
   A fake location page risks a Google penalty and, worse, sends someone in
   crisis to an address that does not exist.

   ⚠ NO INVENTED DRIVE TIMES. Naming the freeway is a fact; "22 minutes" is not
   one anybody has verified against traffic. Phoenix says "about half an hour"
   because that was already checked; everywhere else stays qualitative. */
interface Props {
  city: string;
  eyebrow?: string;
  title: string;
  points: { text: string; d: string }[];
  disclosure: string;
  image: string;
  alt: string;
  caption: string;
}
const { city, eyebrow, title, points, disclosure, image, alt, caption } = Astro.props;
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,470px)] gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          {eyebrow ?? `Serving ${city}, Arizona`}
        </p>

        <h1 class="font-display text-navy mb-6">{title}</h1>

        <ul class="space-y-4 mb-9">
          {points.map(item => (
            <li class="flex items-start gap-3.5 font-body text-charcoal text-[17px] leading-[29px]">
              <span class="w-9 h-9 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-[19px] h-[19px] text-teal" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
                </svg>
              </span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        {/* The where-we-actually-are disclosure. Required on every page that
            uses this component. Do not remove it. */}
        <div class="border-l-2 border-gold pl-5 mb-9 max-w-xl">
          <p class="font-body text-charcoal text-[16px] leading-[26px]">
            <strong class="font-bold">To be clear about where we actually are:</strong> {disclosure}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Talk to someone now
          </a>
          <a href="/locations/chandler/" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            See the facility
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img src={image} alt={alt} class="w-full object-cover aspect-[4/5]" fetchpriority="high" decoding="async" />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">{caption}</p>
      </div>
    </div>
  </div>
</section>
