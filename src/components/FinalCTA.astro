  linkedin:  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  youtube:   'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  pinterest: 'M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345c-.091.379-.293 1.194-.333 1.361-.052.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146A12 12 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z',
  bluesky:   'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.296 5.568-.628 6.383-3.364C23.622 9.418 24 4.458 24 3.768c0-.688-.139-1.86-.902-2.203-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8z',
};


---
{/* Closing CTA. One soft ridge rises behind it — the motif's second and final
     appearance on the page. */}
<section class="bg-cream">
  <Horizon variant="ridge" class="-mb-px" />

  <div class="bg-cream-soft">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8 py-[70px]">
      <h2 class="font-display text-charcoal mb-5">
        Start with one call. We'll take it from there.
      </h2>
      <p class="font-body text-charcoal text-[20px] leading-[33px] mb-9">
        Someone real answers, any hour of the day or night. There is nothing you have to decide on that first call, and nothing you need to have worked out before you make it.
      </p>
      <a href="tel:8883625576" class="inline-flex items-center justify-center gap-3 bg-gold-deep hover:bg-navy text-white font-semibold h-14 px-9 rounded-lg transition-colors font-body text-[17px]">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        <span class="tel-number">Call (888) 362-5576</span>
      </a>
    </div>
  </div>
</section>

<footer class="bg-navy text-white border-t-2 border-gold">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-14">

    {/* The footer has its own job rather than repeating the sticky header:
        who and where we are, what to do in a crisis, proof, and the legal set. */}
    <div class="grid md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr] gap-10 lg:gap-14 mb-12">

      {/* Who and where */}
      <div>
        <img src="/Asset/stock%20photo/Logo%20Buena%20Vista.svg" alt="Buena Vista Health &amp; Recovery Centers" class="h-9 brightness-0 invert mb-5" loading="lazy" decoding="async" />
        <p class="font-body text-white/70 text-[16px] leading-[26px] max-w-sm mb-5">
          Medically supervised detox and residential treatment in Chandler, Arizona.
        </p>
        <p class="font-body text-white/70 text-[15px] leading-[25px] mb-5">
          3033 S Arizona Ave<br />Chandler, AZ 85286<br />
          Open 24 hours, including holidays
        </p>

        <a href="tel:8883625576" class="inline-flex items-center gap-2.5 group">
          <span class="w-10 h-10 rounded-full bg-gold/15 group-hover:bg-gold flex items-center justify-center transition-colors shrink-0">
            <svg class="w-5 h-5 text-gold group-hover:text-navy transition-colors" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
          </span>
          <span>
            <span class="block font-body font-semibold text-white text-[24px] leading-tight tel-number">(888) 362-5576</span>
            <span class="block font-body text-white/50 text-[14px]">Admissions &middot; answered any hour</span>
          </span>
        </a>

        {/* Social. Real profiles, in navigation.ts — add TikTok or X there and
            this row picks them up. */}
        <div class="mt-7">
          <p class="font-body text-gold text-xs font-bold tracking-[0.18em] uppercase mb-3">Follow Buena Vista</p>
          <ul class="flex flex-wrap items-center gap-3">
            {socialLinks.map(s => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  title={s.label}
                  class="w-11 h-11 rounded-full border border-white/20 hover:border-gold hover:bg-gold flex items-center justify-center text-white/80 hover:text-navy transition-colors"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={socialIcons[s.icon]} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Crisis. The standalone crisis page was cut, so this is where those
          numbers live. Do not remove. */}
      <div>
        <p class="font-body text-gold text-xs font-bold tracking-[0.18em] uppercase mb-5">If you need help right now</p>
        <div class="space-y-4">
          <div>
            <p class="font-body font-semibold text-white text-[16px]">988 &mdash; Suicide &amp; Crisis Lifeline</p>
            <p class="font-body text-white/70 text-[15px] leading-[24px]">
              Call or text <a href="tel:988" class="text-gold font-semibold hover:opacity-70 transition-opacity tel-number">988</a>, any hour.
              In immediate danger, call 911.
            </p>
          </div>
          <div>
            <p class="font-body font-semibold text-white text-[16px]">SAMHSA National Helpline</p>
            <p class="font-body text-white/70 text-[15px] leading-[24px]">
              <a href="tel:18006624357" class="text-gold font-semibold hover:opacity-70 transition-opacity tel-number">1-800-662-4357</a> &middot; free and confidential
            </p>
          </div>
        </div>
      </div>

      {/* The few links that are not in the header */}
      <nav aria-label="Footer">
        <p class="font-body text-gold text-xs font-bold tracking-[0.18em] uppercase mb-5">More</p>
        <ul class="space-y-3">
          {visibleFooter.flatMap(col => col.links).map(link => (
            <li>
              <a href={link.href} class="font-body text-white/70 hover:text-white text-[15px] leading-[22px] transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

    {/* Verification. Every one of these is a page a person can open and read
        our listing on, which is the only reason to show a badge at all. The
        Chandler Chamber listing is text-only because we do not hold their
        member logo — ask the client for it and it can join the strip. */}
    <div class="pt-9 border-t border-white/10">
      <p class="font-body text-gold text-xs font-bold tracking-[0.18em] uppercase mb-4">Verify us</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {verificationLinks.map(v => (
          <li>
            <a
              href={v.href}
              target="_blank"
              rel="noopener"
              class="font-body text-white/70 hover:text-white text-[14px] transition-colors underline underline-offset-4 decoration-white/25 hover:decoration-white/60"
            >{v.label}</a>
          </li>
        ))}
      </ul>
    </div>

    {/* Legal */}
    <div class="mt-9 pt-9 border-t border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="font-body text-white/50 text-[13px] leading-[20px]">
        &copy; {new Date().getFullYear()} Buena Vista Health &amp; Recovery Centers. All rights reserved.
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {visibleLegal.map(link => (
          <li>
            <a href={link.href} class="font-body text-white/50 hover:text-white/80 text-[13px] transition-colors">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

  </div>
</footer>
