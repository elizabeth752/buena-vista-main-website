---
import Horizon from './Horizon.astro';
import { footerColumns, legalLinks, socialLinks, SHOW_BUILD_STATUS, HIDE_UNBUILT } from '../data/navigation';

// Same rule as the header: the footer never links to a page that does not exist.
const visibleFooter = footerColumns
  .map(c => ({ ...c, links: c.links.filter(l => !HIDE_UNBUILT || l.built) }))
  .filter(c => c.links.length);
const visibleLegal = legalLinks.filter(l => !HIDE_UNBUILT || l.built);

/* Third-party listings anyone can open and check. These are the citations
   behind the badge strip, plus the Chamber membership, which has no logo. */
const verificationLinks = [
  { label: 'The Joint Commission', href: 'https://www.jointcommission.org/en-us/accreditation/behavioral-health-care-and-human-services/provider-locator/605564/646853' },
  { label: 'LegitScript certification', href: 'https://www.legitscript.com/websites/?checker_keywords=buenavistarecovery.com' },
  { label: 'Psychology Today', href: 'https://www.psychologytoday.com/us/treatment-rehab/buena-vista-health-and-recovery-centers-chandler-az/906339' },
  { label: 'Recovery.com', href: 'https://recovery.com/buena-vista-recovery-chandler-arizona/' },
  { label: 'Chandler Chamber of Commerce', href: 'https://business.chandlerchamber.com/list/member/buena-vista-health-and-recovery-28591' },
];


// Simple-icons paths, single-path each so they knock out cleanly at 20px.
const socialIcons: Record<string, string> = {
