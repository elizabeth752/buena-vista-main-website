---
/* Level-of-care ladder. Described generically ("most programs run…") rather
   than as Buena Vista's own schedule — our IOP is still being built, so no
   hours, days, or group structure here may be presented as ours.

   ALIGNMENT: every label holds one line at the pinned size, every tag follows
   the same shape, and every description is written to the same length. */
const ladder = [
  {
    label: 'Medical detox',
    tag: 'Typically 4 to 7 days',
    desc: 'Substances out of your body under nursing around the clock and physician oversight. You stay with us the whole time.',
    us: true,
  },
  {
    label: 'Residential treatment',
    tag: 'Typically 30 days',
    desc: 'Live-in care once your body is steady. Two groups a day, your own therapist, and a case manager planning what follows.',
    us: true,
  },
  {
    label: 'Partial hospitalization',
    tag: 'Around 6 hours a day',
    desc: 'A full clinical day without living on site. More structure than IOP, and usually too many hours to hold a job alongside.',
    us: false,
  },
  {
    label: 'Intensive outpatient',
    tag: 'Around 3 hours a day',
    desc: 'Most IOPs run three to five days a week, often with an evening track. You live at home or in sober living while you attend.',
    us: false,
  },
];

const points = [
  'A real clinical program, not a check-in: groups, therapy, relapse-prevention work',
  'The difference from residential is simply where you sleep at night',
  'Usually a step down rather than a starting point',
  'Still drinking or using daily? Detox is the safer first step, and that is here',
];
---
<section id="what-is-iop" class="bg-white py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-start">

      <div class="lg:sticky lg:top-24">
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          The level of care
        </p>
        <h2 class="font-display text-charcoal mb-6">
          What is intensive outpatient treatment?
        </h2>

        <p class="font-body text-charcoal text-[17px] leading-[29px] mb-7">
          IOP is structured treatment you attend for a few hours at a time, several days a week, while living at home.
        </p>

        <ul class="space-y-3 mb-8">
          {points.map(p => (
            <li class="flex items-start gap-3 font-body text-charcoal text-[17px] leading-[29px]">
              <svg class="w-5 h-5 text-teal mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>

        <div class="border-l-2 border-gold pl-5 max-w-xl">
          <p class="font-body text-charcoal text-[16px] leading-[26px]">
            Not sure which level you need? It is not a question to guess at. A short call sorts it out: <a href="tel:8883625576" class="text-teal font-semibold hover:opacity-70 transition-opacity tel-number">(888) 362-5576</a>.
          </p>
        </div>
      </div>

      <div class="space-y-4">
        {ladder.map(item => (
          <div class={`rounded-xl p-6 border ${item.us ? 'bg-white border-cream-soft shadow-sm' : 'bg-cream border-cream-soft'}`}>
            <div class="flex items-center justify-between gap-4 mb-2.5">
              <h3 class="ladder-label font-display text-charcoal">{item.label}</h3>
              <span class="shrink-0 font-body text-xs font-bold uppercase tracking-wide text-gold bg-gold/10 rounded-full px-3 py-1.5">
                {item.tag}
              </span>
            </div>
            <p class="font-body text-charcoal text-[16px] leading-[26px] mb-3">{item.desc}</p>
            <p class="font-body text-[13px] font-bold uppercase tracking-[0.1em]">
              {item.us
                ? <span class="text-teal">Offered at our Chandler facility</span>
                : <span class="text-muted">We'll help you find one</span>}
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Unlayered, so it beats the global h3 scale. Every label holds one line at
     this size, which is what keeps the four rows level. */
  .ladder-label { font-size: 22px; line-height: 28px; letter-spacing: 0; }
</style>
