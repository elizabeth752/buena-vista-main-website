---
// Only conditions confirmed in the admissions calls, framed as things treated
// ALONGSIDE addiction. No acute or high-acuity psychiatric conditions are
// listed — those are routed out in ScopeBoundary.
//
// ALIGNMENT: every name holds one line and every description is written to the
// same length, so the six cards line up.
const conditions = [
  {
    name: 'PTSD and trauma',
    desc: 'Very often the thing underneath the substance use rather than a side note to it. Trauma work is what people tell us afterwards made the difference.',
  },
  {
    name: 'Anxiety',
    desc: 'One of the most common conditions we see alongside addiction, and one of the most common reasons people started drinking or using in the first place.',
  },
  {
    name: 'Depression',
    desc: 'Sometimes long-standing, sometimes tied to one specific loss. Either way it does not lift on its own just because the substances have stopped.',
  },
  {
    name: 'Bipolar disorder',
    desc: 'Common here, and often in someone who came off their medication somewhere along the way. Tell us on the phone, because it changes how we care for you.',
  },
  {
    name: 'Grief and loss',
    desc: 'A death, a divorce, a job gone. Relapse very often arrives on the back of one of these, and it deserves treating as a real cause, not an excuse.',
  },
  {
    name: 'Not on this list?',
    desc: 'Everyone arrives with their own particular history. Call and tell us yours, and we will give you an honest answer about whether we are the right fit.',
    highlight: true,
  },
];
---
<section id="conditions" class="bg-white py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-12 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What we support
      </p>
      <h2 class="font-display text-charcoal mb-4">
        Co-occurring conditions we treat alongside addiction
      </h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] max-w-2xl">
        These come up again and again. We address them as part of your treatment rather than treating your recovery in a vacuum.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {conditions.map(c => (
        <div class={`rounded-xl p-8 border flex flex-col h-full ${c.highlight ? 'bg-cream border-cream-soft border-t-4 border-t-gold' : 'bg-white border-cream-soft'}`}>
          <h3 class="condition-title font-display text-charcoal mb-3">{c.name}</h3>
          <p class="font-body text-charcoal text-[16px] leading-[26px]">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Unlayered, so it beats the global h3 scale. Every name holds one line at
     this size, which is what keeps the three columns level. */
  .condition-title { font-size: 26px; line-height: 33px; letter-spacing: 0; }
</style>
