---
/* Reframed from a generic definition of residential treatment to what the
   Buena Vista program specifically is. The keyword still sits in the H2, but
   the body is our program rather than the level of care in the abstract.

   Both card bodies are written to the same length so the two cards line up. */
const comparison = [
  {
    label: 'Medical detox',
    tag: 'Typically 4 to 7 days',
    desc: 'Getting substances safely out of your body and through withdrawal, with nursing around the clock, comfort medication, and a physician overseeing it. Detox looks after your body.',
  },
  {
    label: 'Residential treatment',
    tag: 'Typically 30 days',
    desc: 'Live-in care that starts once your body is steady. Two groups a day, your own therapist, and a case manager planning what comes after. Residential is where you build the tools.',
  },
];

const program = [
  'Thirty days is the usual stay, and up to 45 when that is the right call',
  'Group therapy twice a day, plus individual sessions with your own therapist',
  'A case manager assigned from day one, not the week you leave',
  'Optional 12-step meetings, and phone access from 4:00 to 9:00 PM',
  'Coming here is voluntary, and choosing it yourself is one of the strongest predictors of a good outcome',
];
---
<section id="what-is-residential" class="bg-cream py-[50px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-14 items-start">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          The program
        </p>
        <h2 class="font-display text-charcoal mb-6">
          Residential treatment at Buena Vista
        </h2>

        <p class="font-body text-charcoal text-[17px] leading-[29px] mb-7">
          You live here for about a month and recovery is the only thing on your calendar. No commute, no shift to cover, nothing at home pulling you back mid-week.
        </p>

        <ul class="space-y-3 mb-9">
          {program.map(p => (
            <li class="flex items-start gap-3 font-body text-charcoal text-[17px] leading-[29px]">
              <svg class="w-5 h-5 text-teal mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>

        <a href="tel:8883625576" class="inline-flex items-center justify-center bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
          Talk to our team
        </a>
      </div>

      <div class="space-y-5">
        {comparison.map(item => (
          <div class="bg-white rounded-xl p-7 shadow-sm border border-cream-soft">
            <div class="flex items-center justify-between gap-4 mb-3">
              <h3 class="font-display text-2xl text-charcoal">{item.label}</h3>
              <span class="shrink-0 font-body text-xs font-bold uppercase tracking-wide text-gold bg-gold/10 rounded-full px-3 py-1.5">
                {item.tag}
              </span>
            </div>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{item.desc}</p>
          </div>
        ))}

        <div class="flex gap-4 bg-navy-deep rounded-xl p-7 text-white">
          <svg class="w-6 h-6 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
          </svg>
          <p class="font-body text-white/85 text-[16px] leading-[26px]">
            <strong class="text-white font-bold">One continuum, one team.</strong> Detox and residential both happen in this building, so you move between them without a second admission, a second facility, or telling your story to anyone new. The case manager you meet on day one stays yours.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
