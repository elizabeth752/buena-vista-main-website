---
import { team } from '../data/team';

/* The roster lives in src/data/team.ts so the grid, the blog bylines, the
   reviewer credits and the individual bio pages cannot drift apart. Each card
   links to that person's page — an unlinked bio is an invisible one, and the
   E-E-A-T value of these pages depends on them being reachable. */
interface Props { eyebrow?: string; heading?: string; bg?: string; }
const { eyebrow, heading, bg = 'bg-white' } = Astro.props;
---
<section id="team" class={`${bg} py-[60px]`}>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="mb-14 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        {eyebrow ?? 'The People Behind Your Care'}
      </p>
      <h2 class="font-display text-charcoal mb-4">{heading ?? 'Experienced. Licensed. In your corner.'}</h2>
      <p class="font-body text-charcoal max-w-2xl text-[17px] leading-[29px]">
        Putting your life — or your loved one's life — in someone else's hands is an enormous act of trust. Here's who's on the other side of that trust.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {team.map(member => (
        <a
          href={`/about/team/${member.slug}/`}
          class="group bg-cream rounded-xl overflow-hidden hover:shadow-xl transition-shadow flex flex-col h-full w-full max-w-[320px] mx-auto sm:max-w-none sm:mx-0 border border-transparent hover:border-teal"
        >
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src={member.photo}
              alt={`${member.name} — ${member.title} at Buena Vista Recovery`}
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-gold font-body text-[12px] font-bold tracking-[0.14em] uppercase mb-2">{member.title}</p>
            <h3 class="font-body font-semibold text-[18px] leading-tight text-charcoal">{member.name}</h3>
            {member.credentials && (
              <p class="font-body text-[15px] leading-[24px] text-muted mt-0.5">{member.credentials}</p>
            )}
            <span class="font-body text-teal font-semibold text-[15px] mt-3 group-hover:underline">Read bio &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
