---
const BASE = '/Asset/Facility/';

const images = [
  { file: '8. Evening exterior facade with illuminated entrance and curved driveway.png', alt: 'Evening exterior facade with illuminated entrance and curved driveway' },
  { file: '9. Sunlit common hall with lounge furniture, tall windows, and open floor plan.png', alt: 'Sunlit common hall with lounge furniture and tall windows' },
].map(i => ({ ...i, src: BASE + i.file.replace(/ /g, '%20') }));
---
<section class="w-full">
  <div class="flex flex-col md:flex-row w-full">
    {images.map((img, i) => (
      <div class={`${i === 1 ? 'hidden md:block' : ''} w-full md:w-1/2 h-[320px] md:h-[500px] max-h-[500px]`}>
        <img
          src={img.src}
          alt={img.alt}
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    ))}
  </div>
</section>
