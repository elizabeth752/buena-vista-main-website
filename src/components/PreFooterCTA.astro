---
---
<section class="bg-cream py-[50px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_380px] gap-12 lg:gap-20 items-center">

      <!-- Left: Editorial copy -->
      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-6 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Take the First Step
        </p>

        <h2 class="font-display text-black mb-10">
          Ready for an Honest Conversation About Getting Better?
        </h2>

        <div class="space-y-8">
          <!-- Person struggling -->
          <div class="flex gap-5">
            <div class="w-0.5 bg-gold rounded-full shrink-0 self-stretch"></div>
            <div>
              <p class="font-body font-bold text-black text-sm mb-2 uppercase tracking-wide">If you're the one struggling</p>
              <p class="font-body text-black text-base leading-relaxed">
                You don't have to have it all figured out. You don't have to be at rock bottom. You just have to make one call — and we'll meet you exactly where you are, without judgment.
              </p>
            </div>
          </div>

          <!-- Family member -->
          <div class="flex gap-5">
            <div class="w-0.5 bg-navy rounded-full shrink-0 self-stretch"></div>
            <div>
              <p class="font-body font-bold text-black text-sm mb-2 uppercase tracking-wide">If you're calling for someone you love</p>
              <p class="font-body text-black text-base leading-relaxed">
                That call matters just as much. We'll walk you through every option — intervention support, what to expect, how to talk to your loved one. You don't have to carry this alone either.
              </p>
            </div>
          </div>
        </div>

        <!-- Trust signals -->
        <div class="flex flex-wrap gap-x-8 gap-y-3 mt-10">
          {[
            ['100% Confidential', 'M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'],
            ['HIPAA Compliant', 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z'],
            ['No Pressure, Ever', 'M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'],
          ].map(([label, path]) => (
            <span class="flex items-center gap-2 font-body text-black text-sm">
              <svg class="w-4 h-4 text-gold shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d={path} clip-rule="evenodd"/>
              </svg>
              {label}
            </span>
          ))}
        </div>
      </div>

      <!-- Right: Phone CTA card -->
      <div class="bg-navy rounded-2xl p-5 md:p-10 text-white flex flex-col items-center text-center shadow-2xl">
        <!-- Icon -->
        <div class="w-16 h-16 rounded-full bg-white flex items-center justify-center mb-3 md:mb-6">
          <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
        </div>

        <p class="font-body text-white text-xs uppercase tracking-[0.2em] mb-1 md:mb-3">Call us anytime</p>

        <a href="tel:8883625576" class="font-display text-[24px] md:text-[36px] text-white hover:opacity-70 transition-opacity mb-1 md:mb-2 leading-none block">
          (888) 362-5576
        </a>

        <p class="font-body text-gold text-xs font-semibold tracking-wide mb-4 md:mb-8">
          Available 24 hours · 7 days a week
        </p>

        <div class="w-full h-px bg-white/10 mb-4 md:mb-8"></div>

        <a
          href="tel:8883625576"
          class="w-full bg-white hover:bg-cream text-black font-bold py-4 rounded-lg transition-colors font-body tracking-wide text-sm"
        >
          Speak With Someone Now
        </a>

        <p class="font-body text-white text-xs mt-3 md:mt-5 leading-relaxed">
          Or fill out the insurance form above —<br/>we'll reach out on your timeline.
        </p>
      </div>

    </div>
  </div>
</section>
