---
import InsuranceForm from './InsuranceForm.astro';

/* STANDARD COVERAGE CTA — the one form block used across the site.

   The shape is fixed on purpose: keyword-carrying H2, short bullets instead of
   a paragraph nobody reads, a wall of payer logos, an accreditation strip, and
   the form. Pages override the heading and the bullets so the H2 can carry the
   page's keyword; nothing else varies.

   ⚠ A LOGO IS A SOFT CLAIM, NOT A NETWORK CLAIM. These sit under "we work with
   plans like these — we will check yours", never "we are in network with
   these". Deliberately absent because admissions says we are NOT in network:
   UnitedHealthcare, Mercy Care, Arizona Complete Health, and Medicare (we are
   not Medicare-certified). Banner University Family Care and Molina are the two
   most-asked-for plans and both ARE accepted; Elizabeth supplied their artwork
   on 2026-09-08. */
interface Props {
  heading?: string;
  bullets?: string[];
  bg?: string;
}

const {
  heading = "Will your insurance cover treatment at Buena Vista?",
  bullets = [
    'We check your benefits while you are on the phone, usually in a few minutes',
    'It costs nothing and you owe nothing either way',
    'AHCCCS and commercial plans both cover care here',
  ],
  bg = 'bg-sage-tint',
} = Astro.props;

const insurers = [
  // Interleaved on purpose: leading with five AHCCCS plans would read as a
  // Medicaid-first practice, and leading with five commercial ones would bury
  // the plans most of our callers actually hold.
  { name: 'Banner University Family Care', logo: '/Asset/Insurances/Banner-University-Family-Care.png', max: 'max-h-[54px]' },
  { name: 'Aetna',                         logo: '/Asset/Insurances/Aetna.svg' },
  { name: 'Blue Cross Blue Shield',        logo: '/Asset/Insurances/BCBS.svg' },
  { name: 'Molina Healthcare',             logo: '/Asset/Insurances/Molina.png' },
  { name: 'Cigna',                         logo: '/Asset/Insurances/Cigna.svg' },
  { name: 'AHCCCS',                        logo: '/Asset/Insurances/AHCCCS.png' },
  { name: 'Humana',                        logo: '/Asset/Insurances/Humana.svg' },
  { name: 'Health Choice Arizona',         logo: '/Asset/Insurances/Health-Choice-Arizona.svg', max: 'max-h-[48px]' },
  { name: 'Anthem',                        logo: '/Asset/Insurances/Anthem.svg' },
  { name: 'AHCCCS AIHP',                   logo: '/Asset/Insurances/AHCCCS-AIHP.svg' },
  { name: 'Magellan Health',               logo: '/Asset/Insurances/Magellan.svg' },
  { name: 'Optum',                         logo: '/Asset/Insurances/Optum.svg' },
];

const accreditations = [
  { src: '/Asset/Accreditations/The%20Joint%20Commission.svg', alt: 'The Joint Commission Accredited' },
  { src: '/Asset/Accreditations/Legit.svg',                    alt: 'LegitScript Certified' },
  { src: '/Asset/Accreditations/NAATP.svg',                    alt: 'NAATP Member' },
  { src: '/Asset/Accreditations/psychology_today%201.svg',     alt: 'Psychology Today Verified' },
  { src: '/Asset/Accreditations/BBB.svg',                      alt: 'BBB Accredited' },
];
---
<section class={`${bg} py-[60px]`}>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_minmax(0,420px)] gap-12 items-start">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Coverage
        </p>
        <h2 class="font-display text-charcoal mb-6">{heading}</h2>

        <ul class="space-y-3 mb-9 max-w-xl">
          {bullets.map(b => (
            <li class="flex items-start gap-3 font-body text-charcoal text-[17px] leading-[29px]">
              <svg class="w-5 h-5 text-teal mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              {b}
            </li>
          ))}
        </ul>

        <p class="font-body text-muted text-[13px] font-bold tracking-[0.12em] uppercase mb-4">
          Plans we work with
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-9">
          {insurers.map(ins => (
            <div class="flex items-center justify-center bg-white rounded-xl px-4 py-3 shadow-sm border border-cream-soft h-[80px]">
              <img src={ins.logo} alt={ins.name} class={`${ins.max ?? 'max-h-9'} max-w-full object-contain`} loading="lazy" />
            </div>
          ))}
        </div>

        <p class="font-body text-muted text-[15px] leading-[24px] mb-8 max-w-xl">
          Do not see your plan? Call and we will check it. If we are not in network,
          we will say so and help you find somewhere that is.
        </p>

        {/* Accreditation, kept high on the page rather than buried in the footer */}
        <div class="pt-7 border-t border-charcoal/10">
          <p class="font-body text-muted text-[13px] font-bold tracking-[0.12em] uppercase mb-4">
            Accredited and verified
          </p>
          <div class="flex flex-wrap items-center gap-3">
            {accreditations.map(a => (
              <div class="bg-white rounded-lg px-3 py-2 flex items-center justify-center border border-cream-soft" style="min-width:84px; height:52px;">
                <img src={a.src} alt={a.alt} class="max-h-9 max-w-[92px] object-contain" loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </div>

      <InsuranceForm id="verify" class="lg:sticky lg:top-24" />

    </div>
  </div>
</section>
