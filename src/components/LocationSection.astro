---
---
<section id="location" class="bg-white py-[50px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center justify-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        Find Us
        <span class="w-6 h-px bg-gold inline-block"></span>
      </p>
      <h2 class="font-display text-black mb-4">
        Our Addiction Treatment Center in Chandler, AZ
      </h2>
      <p class="font-body text-black max-w-xl mx-auto text-base leading-relaxed">
        Located in Chandler, Arizona — easily accessible from Phoenix, Tempe, Mesa, Gilbert, and the greater East Valley.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 items-stretch">
      <!-- Info panel -->
      <div class="flex flex-col gap-5">
        <!-- Photo -->
        <div class="rounded-2xl overflow-hidden h-[220px] lg:h-[280px]">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Chandler%20recovery%20center%20exterior%20with%20covered%20entrance%20and%20tower%20feature.png"
            alt="Buena Vista Health & Recovery Centers — Chandler, AZ exterior"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Address & details card -->
        <div class="bg-white border-2 border-navy rounded-2xl p-5 lg:p-7">
          <div class="flex items-start gap-3 mb-5">
            <span class="w-8 h-8 bg-gold rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </span>
            <div>
              <p class="font-body font-bold text-black text-sm">Buena Vista Health & Recovery Centers</p>
              <p class="font-body text-black text-sm">3033 S Arizona Ave, Chandler, AZ 85286</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-6">
            {[
              ['Hours', 'Open 24/7 · 365 days'],
              ['Phone', '(888) 362-5576'],
            ].map(([k, v]) => (
              <div>
                <p class="text-gold font-body text-xs font-bold uppercase tracking-wide mb-1">{k}</p>
                <p class="font-body text-black text-sm">{v}</p>
              </div>
            ))}
          </div>

          <a href="tel:8883625576" class="block text-center bg-navy hover:bg-navy-mid text-white font-bold px-5 py-2.5 rounded transition-colors font-body text-sm tracking-wide">
            Check Availability
          </a>
        </div>
      </div>

      <!-- Map -->
      <div class="rounded-2xl overflow-hidden shadow-lg h-[220px] lg:h-full">
        <iframe
          title="Buena Vista Recovery Chandler Location"
          src="https://maps.google.com/maps?q=3033+S+Arizona+Ave,+Chandler,+AZ+85286&t=&z=15&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
