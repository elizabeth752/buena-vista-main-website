---
import RevealCards from '../RevealCards.astro';

/* The single most useful thing a category page can say: opioids need a
   medically supervised detox, and that is the opposite of the stimulant
   pathway. Keep the contrast — people arrive assuming all substances work the
   same way and plan around the wrong one.

   MAT BOUNDARY: maintenance medication is "tell us so the doctors can plan",
   never an offer to continue or prescribe. */
const steps = [
  { n: '01', h: 'Detox comes first', tag: '4 to 7 days', p: 'Opioid withdrawal arrives fast and hard, and it is why most attempts to stop at home come apart inside a day. Nursing around the clock, physician oversight, medication from the start.' },
  { n: '02', h: 'Then residential', tag: 'Around 30 days', p: 'Detox settles the body. Residential is where the reasons get worked on: group therapy twice a day, one-to-one sessions, and a case manager planning what happens after.' },
  { n: '03', h: 'More than one thing', tag: 'Expected here', p: 'Meth alongside fentanyl is common, and so is alcohol. Your detox is planned around everything at once, as one admission rather than a sequence of separate ones.' },
  { n: '04', h: 'Already on a dose', tag: 'Say so early', p: 'Arriving on methadone or Suboxone is common and not a complication anyone minds. Tell us the dose and how long, so our providers review it before you arrive rather than on the day.' },
];
---
<section id="pathway" class="bg-sage-tint py-[70px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        How opioid treatment works here
      </p>
      <h2 class="font-display text-charcoal mb-5">Detox first, and that is not optional advice</h2>
      <p class="font-body text-charcoal text-[18px] leading-[30px]">
        This is where opioids differ from stimulants. If your body is physically dependent, starting with a supervised detox is what makes everything after it possible.
      </p>
    </div>
    <RevealCards class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {steps.map(s => (
        <div class="reveal-card bg-white rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold h-full">
          <p class="font-display text-gold text-[32px] leading-none mb-4">{s.n}</p>
          <h3 class="font-display text-[21px] leading-[27px] text-navy mb-2">{s.h}</h3>
          <span class="inline-block font-body text-xs font-bold uppercase tracking-wide text-gold bg-gold/10 rounded-full px-3 py-1.5 mb-4">{s.tag}</span>
          <p class="font-body text-charcoal text-[16px] leading-[26px]">{s.p}</p>
        </div>
      ))}
    </RevealCards>
  </div>
</section>

<style>
  /* Unlayered, so it beats the global h3 scale. One line per title keeps the
     four columns level. */
  .op-title { font-size: 22px; line-height: 28px; letter-spacing: 0; min-height: 56px; }
</style>
