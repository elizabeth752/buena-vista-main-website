---
// Titles are single strings — the previous version hard-coded a <br> between two
// halves, which is what made them wrap badly inside a narrow card.
const pillars = [
  {
    title: 'We start by listening',
    desc: "Your first conversation here is not an interrogation. We ask what's been happening and we listen to the answer — where you actually are right now, not the worst day you've had.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48L4.5 20.25l3.75-1.125A9.06 9.06 0 0012 20.25z"/></svg>`,
  },
  {
    title: 'Someone knows your name',
    desc: 'Licensed clinicians and medical staff are involved at every level of care. You are never a bed number — the person watching your progress knows who you are and what you are working through.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.118a7.5 7.5 0 0115 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.5-1.632z"/></svg>`,
  },
  {
    title: 'We treat what is underneath',
    desc: "Addiction rarely shows up alone. When anxiety, depression, PTSD, or trauma are part of the picture, we treat all of it at the same time — because what's underneath is usually what pulls people back.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>`,
  },
  {
    title: 'Therapies that actually work',
    desc: 'CBT, DBT, EMDR, motivational interviewing, and trauma therapy are part of daily care here — not a list on a brochure, but the work you do in the room, with someone trained to do it well.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    title: 'Your family is welcome here',
    desc: 'If someone you love is in treatment with us, you are not on the outside of it. We bring families in on purpose — because the people who love someone through this carry a great deal of it themselves.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72M6.34 18.72a9.09 9.09 0 01-3.74-.479 3 3 0 014.68-2.72m11.72 3.199a5.971 5.971 0 00-.94-3.197A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.06 2.772 5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    title: 'Room to breathe, and to heal',
    desc: 'Mindfulness, fitness, life skills, and quiet time are part of the day, not extras. Recovery is about rebuilding a life worth staying sober for, and that takes more than clinical hours.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18c-3 4.5-3 7.5 0 12m0-12c3 4.5 3 7.5 0 12M4.5 9c2.25 1.5 3.75 3.75 3.75 6M19.5 9c-2.25 1.5-3.75 3.75-3.75 6"/></svg>`,
  },
  {
    title: 'The same team, all the way through',
    desc: "From your first day of detox through months of aftercare, you won't be handed between strangers. The people who start with you are the people who see it through.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>`,
  },
  {
    title: "We stay, even when it's hard",
    desc: 'People have bad days here, and change their minds, and want to leave. That is part of it. Nobody gets written off for having a hard week — we stay in it with you.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>`,
  },
];
---
<section class="bg-cream py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="mb-14 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What makes us different
      </p>
      <h2 class="font-display text-charcoal mb-4">
        Care that starts with a conversation
      </h2>
      <p class="font-body text-charcoal max-w-2xl text-[17px] leading-[29px]">
        Plenty of treatment centers say the right things. What our clients tell us they noticed was smaller and more ordinary than that — being remembered, being fed well, being spoken to like an adult on a hard day.
      </p>
    </div>

    <!-- Three-up so the serif headings have room to sit on one or two lines.
         h-full equalizes card heights across the row. -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map(p => (
        <div class="bg-white rounded-xl p-8 border border-cream-soft hover:shadow-md hover:border-gold/30 transition-all group flex flex-col h-full">
          <div class="mb-5 p-2.5 bg-cream rounded-lg w-fit shadow-sm group-hover:shadow-md transition-shadow" set:html={p.icon}></div>
          <h3 class="font-display text-2xl text-charcoal mb-3 leading-snug">{p.title}</h3>
          <p class="font-body text-charcoal text-[16px] leading-[26px]">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
