---
const pillars = [
  {
    title: ['Honest', 'Assessment'],
    desc: 'We start by seeing you clearly — not your worst moment, but where you actually are right now. No sugarcoating. No judgment. Just the truth, delivered with respect.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M21 21l-3.5-3.5"/><path stroke-linecap="round" d="M8.5 11.5l2 2 3-3.5"/></svg>`,
  },
  {
    title: ['Clinical Supervision', 'Every Day'],
    desc: 'Licensed clinicians and medical staff are involved at every level of care. You are never just a bed number — someone who knows your name and your case is watching over your progress.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" d="M9 12h6m-3-3v6m-7 1a7 7 0 1114 0v1a2 2 0 01-2 2H6a2 2 0 01-2-2v-1z"/><circle cx="12" cy="7" r="3"/></svg>`,
  },
  {
    title: ['Dual', 'Diagnosis Care'],
    desc: 'Addiction rarely shows up alone. When anxiety, depression, PTSD, or trauma are part of the picture, we treat all of it — because ignoring what\'s underneath is how people relapse.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" d="M9.5 4C7 4 5 6.2 5 9c0 4.5 7 11 7 11s7-6.5 7-11c0-2.8-2-5-4.5-5-1.2 0-2.2.6-3 1.5-.8-.9-1.8-1.5-3-1.5z"/></svg>`,
  },
  {
    title: ['Evidence-Based', 'Therapies'],
    desc: 'CBT, DBT, EMDR, Motivational Interviewing, Trauma Therapy — these are the tools we use every day, because they actually work.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><rect x="8" y="2" width="8" height="4" rx="1"/><path stroke-linecap="round" d="M8 4H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2"/><path stroke-linecap="round" d="M9 12l2 2 4-4"/></svg>`,
  },
  {
    title: ['Family Is', 'Part of Recovery'],
    desc: 'If someone you love is in treatment here, you are not on the outside. We involve families intentionally — because loved ones often carry just as much pain.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="9" r="2.5"/><path stroke-linecap="round" d="M3 19c0-3.3 2.7-6 6-6h2"/><path stroke-linecap="round" d="M13 19c0-2.2 1.8-4 4-4s4 1.8 4 4"/></svg>`,
  },
  {
    title: ['Holistic', 'Programming'],
    desc: 'Mindfulness, fitness, life skills, meditation — woven into daily care. Recovery is about rebuilding a life worth living, tending to the whole person.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" d="M12 3c-4 6-4 9 0 12s4 6 0 9M8 6c2 2 3 5 1 8M16 6c-2 2-3 5-1 8"/></svg>`,
  },
  {
    title: ['A Full', 'Path Forward'],
    desc: 'From the first day of detox to months of aftercare, you won\'t be handed off and forgotten. Our continuum of care follows you through every transition.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M9 12h6m-3-3l3 3-3 3"/></svg>`,
  },
  {
    title: ['We Finish', 'What We Start'],
    desc: 'Accountability is a core value here — for our staff as much as for our clients. We don\'t abandon people mid-journey. We stay in it with you, even when it\'s hard.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-7 h-7 text-gold"><path stroke-linecap="round" d="M12 3l2.5 5.5L20 9.5l-4 4 1 5.5L12 16.5 7 19l1-5.5-4-4 5.5-1z"/></svg>`,
  },
];
---
<section class="bg-white py-[50px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center justify-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What Makes Us Different
        <span class="w-6 h-px bg-gold inline-block"></span>
      </p>
      <h2 class="font-display text-black mb-4">
        Treatment Built on Truth, Structure & Integrity
      </h2>
      <p class="font-body text-black max-w-2xl mx-auto text-base leading-relaxed">
        A lot of treatment centers say the right things. We're less interested in saying them and more interested in doing them — every day, with every person who walks through our doors.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {pillars.map(p => (
        <div class="bg-cream rounded-xl p-6 border border-cream-soft hover:shadow-md hover:border-gold/30 transition-all group text-center sm:text-left">
          <div class="mb-4 p-2.5 bg-white rounded-lg w-fit shadow-sm group-hover:shadow-md transition-shadow mx-auto sm:mx-0" set:html={p.icon}></div>
          <h3 class="font-display text-xl text-black mb-2">{p.title[0]}<br />{p.title[1]}</h3>
          <p class="font-body text-black text-sm leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-6 sm:mt-12">
      <a href="tel:8883625576" class="bg-navy hover:bg-navy-mid text-white font-bold px-9 py-4 rounded transition-colors font-body tracking-wide inline-block">
        Talk to Someone on Our Team
      </a>
    </div>
  </div>
</section>
