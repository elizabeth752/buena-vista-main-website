---
/* Rebuilt for scanning.

   The previous version was six description cards followed by two paragraphs of
   prose — you read the headings and nothing else. Every substance now has a real
   page of its own, so this works better as a way IN to those pages than as a
   summary of them: name first, one short qualifier, whole tile clickable.

   Only tiles with a real destination are linked. Cannabis and prescription
   misuse fold into the hub and the opioid category rather than getting weak
   links of their own. */
const substances = [
  { name: 'Alcohol', note: 'The most common reason people call', href: '/what-we-treat/alcohol-addiction/' },
  { name: 'Fentanyl & opioids', note: 'Detox first, with medication', href: '/what-we-treat/opioid-addiction/' },
  { name: 'Meth & stimulants', note: 'Usually straight to residential', href: '/what-we-treat/stimulant-addiction/' },
  { name: 'Benzodiazepines', note: 'Xanax, Klonopin, Ativan', href: '/what-we-treat/benzodiazepine-addiction/' },
  { name: 'Dual diagnosis', note: 'Addiction and mental health together', href: '/dual-diagnosis' },
];

const mental = [
  { name: 'Anxiety', href: '/what-we-treat/anxiety/' },
  { name: 'Depression', href: '/what-we-treat/depression/' },
  { name: 'PTSD & trauma', href: null },
  { name: 'Mood disorders', href: null },
];
---
<section id="treatment" class="bg-navy-deep text-white py-[70px] relative overflow-hidden bv-watermark bv-watermark--light">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-10 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What we treat
      </p>
      <h2 class="font-display text-white mb-4">
        Find help for what you're facing right now
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      {substances.map(s => (
        <a href={s.href} class="group bg-white rounded-xl p-6 hover:bg-cream transition-colors flex flex-col justify-between min-h-[168px]">
          <h3 class="font-display text-[26px] leading-[32px] text-navy mb-3 [overflow-wrap:anywhere]">{s.name}</h3>
          <div>
            <p class="font-body text-charcoal/75 text-[15px] leading-[22px] mb-2">{s.note}</p>
            <span class="font-body text-teal font-bold text-[14px] group-hover:underline">See treatment &rarr;</span>
          </div>
        </a>
      ))}
      <a href="/what-we-treat/" class="group bg-navy border border-white/15 rounded-xl p-6 hover:border-gold transition-colors flex flex-col justify-between min-h-[168px]">
        <h3 class="font-display text-[26px] leading-[32px] text-white mb-3">Something else</h3>
        <div>
          <p class="font-body text-white/60 text-[15px] leading-[22px] mb-2">Cannabis, prescription drugs, more than one thing at once</p>
          <span class="font-body text-gold font-bold text-[14px] group-hover:underline">See everything &rarr;</span>
        </div>
      </a>
    </div>

    <div class="border-t border-white/15 pt-9 grid lg:grid-cols-[1fr_auto] gap-8 items-start">
      <div>
        <h3 class="font-body text-gold text-xs font-bold tracking-[0.18em] uppercase mb-4">Treated alongside, not afterwards</h3>
        <div class="flex flex-wrap gap-2.5 mb-5">
          {mental.map(c => (
            c.href
              ? <a href={c.href} class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-body text-[15px] font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-colors">{c.name}</a>
              : <span class="bg-white/5 border border-white/10 text-white/80 font-body text-[15px] font-semibold px-4 py-2 rounded-full whitespace-nowrap">{c.name}</span>
          ))}
        </div>
        <p class="font-body text-white/70 text-[16px] leading-[26px] max-w-2xl">
          Treating one without the other rarely holds, so both happen in the same programme.
        </p>
      </div>

      <div class="bg-white/5 border-l-2 border-gold pl-5 py-1 max-w-sm">
        <p class="font-body text-white/80 text-[15px] leading-[25px]">
          Having thoughts of suicide will not disqualify you from care — say so when you call.
          If you need someone right now, call or text
          <a href="tel:988" class="text-gold font-semibold hover:opacity-70 transition-opacity tel-number">988</a>.
        </p>
      </div>
    </div>

  </div>
</section>
