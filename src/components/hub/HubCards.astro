---
/* Card grid for hub children. Items with an `href` render as links; items
   without one are described in place rather than pointing at a page that does
   not exist yet. Add the href when the page ships.

   ALIGNMENT: labels vary from one word ("Heroin") to three ("Methadone &
   buprenorphine"), and tags are optional, so both areas are given a fixed
   floor. Every card's body copy then starts at the same height whatever is
   above it. Sizes are set in the scoped <style> because global.css declares
   the h3 scale outside any @layer, so a Tailwind class on an h3 is ignored. */
export interface HubItem {
  label: string;
  tag?: string;
  desc: string;
  href?: string;
}
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  items: HubItem[];
  columns?: 1 | 2 | 3 | 4;
  bg?: string;
}
const { eyebrow, title, intro, items, columns = 3, bg = 'bg-cream' } = Astro.props;

// Reserve the tag row only when this set uses tags at all. A set with none
// should not carry an empty band under every label.
const hasTags = items.some(i => i.tag);
// A single card is capped rather than stretched: a full-width row of one reads
// as a banner, not a card.
const grid = columns === 1 ? 'grid-cols-1 max-w-2xl' : columns === 2 ? 'sm:grid-cols-2' : columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<section class={`${bg} py-[60px]`}>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-11">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        {eyebrow}
      </p>
      <h2 class="font-display text-charcoal mb-4">{title}</h2>
      {intro && <p class="font-body text-charcoal text-[18px] leading-[30px]">{intro}</p>}
    </div>

    <div class={`grid ${grid} gap-6 items-stretch`}>
      {items.map(item => {
        const inner = (
          <>
            <h3 class="hub-label font-display text-navy">{item.label}</h3>
            <div class={hasTags ? 'hub-tag mb-3' : 'mb-3'}>
              {item.tag && (
                <span class="inline-block font-body text-xs font-bold uppercase tracking-wide text-gold bg-gold/10 rounded-full px-3 py-1.5">{item.tag}</span>
              )}
            </div>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{item.desc}</p>
            {item.href && <span class="inline-block mt-4 font-body text-teal font-semibold text-[15px] group-hover:underline">Read more &rarr;</span>}
          </>
        );
        return item.href
          ? <a href={item.href} class="group bg-white rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold shadow-sm hover:border-teal transition-colors block h-full">{inner}</a>
          : <div class="bg-white rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold h-full">{inner}</div>;
      })}
    </div>
  </div>
</section>

<style>
  /* Unlayered, so these beat the global h3 scale. Two lines held for every
     label and one row for every tag, present or not, so the descriptions
     across a row all begin at the same height. */
  .hub-label { font-size: 22px; line-height: 28px; letter-spacing: 0; min-height: 56px; }
  .hub-tag { min-height: 30px; }
</style>
