---
/* Shared hero for the section hubs.

   Upgraded to the hero standard: the H1 carries the keyword, an optional
   `promise` line sits directly above the bullets where eyes land, `intro` is
   optional so a page can drop the subtitle entirely, and points may carry
   their own icon.

   Backwards compatible on purpose — the other hubs still pass a plain string
   array and an intro, and get the check icon and the old layout until each is
   converted one page at a time. */
interface Point { text: string; d: string; }
interface Props {
  eyebrow: string;
  title: string;
  promise?: string;
  intro?: string;
  points?: (string | Point)[];
  image: string;
  alt: string;
  caption?: string;
}
const { eyebrow, title, promise, intro, points = [], image, alt, caption } = Astro.props;

const CHECK = 'M4.5 12.75l6 6 9-13.5';
const items: Point[] = points.map(p => typeof p === 'string' ? { text: p, d: CHECK } : p);

import Horizon from '../Horizon.astro';
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[76px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,420px)] gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          {eyebrow}
        </p>
        <h1 class="font-display text-navy mb-6">{title}</h1>

        {promise && (
          <p class="font-display text-navy text-[26px] leading-[34px] md:text-[30px] md:leading-[39px] border-l-[3px] border-gold pl-5 mb-8 max-w-xl">
            {promise}
          </p>
        )}

        {intro && <p class="font-body text-charcoal text-[20px] leading-[33px] max-w-xl mb-8">{intro}</p>}

        {items.length > 0 && (
          <ul class="space-y-4 mb-9">
            {items.map(item => (
              <li class="flex items-start gap-3.5 font-body text-charcoal text-[17px] leading-[29px]">
                <span class="w-9 h-9 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-[19px] h-[19px] text-teal" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
                  </svg>
                </span>
                <span>{item.text}</span>
              </li>
            ))}
          </ul>
        )}

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Talk to someone now
          </a>
          <a href="#verify" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            Check my insurance
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img src={image} alt={alt} class="w-full object-cover aspect-[4/5]" fetchpriority="high" decoding="async" />
        </div>
        <Horizon variant="rule" class="mt-5" />
        {caption && <p class="font-body text-muted text-[15px] leading-[24px] mt-3">{caption}</p>}
      </div>
    </div>
  </div>
</section>
