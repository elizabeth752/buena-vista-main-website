---
// The two audiences, answered directly. This sits high on the page because a
// frightened person and a worried parent both need to be spoken to before
// anything else. Specifics replace census metrics — a family member does not
// care about bed count.
const specifics = [
  ['Your own room', "A private room with a private bathroom. You won't share, and you won't sleep on a ward."],
  ['Meals made daily', 'Catered by a dedicated culinary team, with a rotating menu and dietary needs accommodated.'],
  ["Staff who've been there", "Many of the people who will care for you are in recovery themselves. The empathy isn't training."],
  ['One team, start to finish', 'Detox and residential under one roof, with the same case manager from your first day.'],
];
---
<section class="bg-cream py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-start">

      <!-- Left: the two audiences -->
      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Wherever you're starting from
        </p>
        <h2 class="font-display text-charcoal mb-8">
          You don't have to have it figured out before you call
        </h2>

        <div class="space-y-7">
          <div class="border-l-2 border-teal pl-6">
            <p class="font-body font-bold text-charcoal text-[17px] mb-2">If you're the one struggling</p>
            <p class="font-body text-charcoal text-[17px] leading-[29px]">
              You don't have to be at your lowest. You don't have to be certain. You don't even have to know what you want to say. You can call and just start talking, and we'll take it from there — no judgment, and nothing you have to decide today.
            </p>
          </div>

          <div class="border-l-2 border-gold pl-6">
            <p class="font-body font-bold text-charcoal text-[17px] mb-2">If you're calling for someone you love</p>
            <p class="font-body text-charcoal text-[17px] leading-[29px]">
              You already know how it feels to watch someone disappear into this. You're tired, and you may be frightened, and both of those are allowed. Calling for someone else is an act of love, not a betrayal — and we'll walk you through every option there is.
            </p>
          </div>
        </div>

        <div class="mt-10">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Call any time — we're here 24/7
          </a>
        </div>
      </div>

      <!-- Right: what that actually looks like -->
      <div class="grid sm:grid-cols-2 gap-5">
        {specifics.map(([title, desc]) => (
          <div class="bg-white rounded-xl p-7 border border-cream-soft flex flex-col">
            <div class="w-10 h-10 rounded-full bg-gold/15 flex items-center justify-center mb-4 shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
            </div>
            <p class="font-body font-bold text-charcoal text-[17px] mb-2 leading-snug">{title}</p>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{desc}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
