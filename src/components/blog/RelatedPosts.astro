---
import posts from '../../data/blog/posts.json';

/* Interlinking. Same category first, then the best performers, so every
   article routes onward rather than dead-ending. */
interface Props { slug: string; category: string; }
const { slug, category } = Astro.props;
const pool = posts.filter(p => p.slug !== slug);
const related = [...pool.filter(p => p.category === category), ...pool.filter(p => p.category !== category)].slice(0, 3);
---
<section class="bg-cream py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
      <span class="w-6 h-px bg-gold inline-block"></span>
      Keep reading
    </p>
    <h2 class="font-display text-charcoal mb-9">More on this</h2>
    <div class="grid md:grid-cols-3 gap-6 items-stretch">
      {related.map(p => (
        <a href={`/blog/${p.slug}/`} class="group bg-white rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold h-full block hover:border-teal transition-colors">
          <p class="font-body text-gold text-xs font-bold tracking-[0.14em] uppercase mb-3">{p.category}</p>
          <h3 class="related-title font-display text-navy mb-3">{p.title}</h3>
          <p class="font-body text-muted text-[15px] leading-[24px]">{p.readMinutes} min read</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Unlayered, so it beats the global h3 scale. Three lines held so the cards
     line up whatever the headline length. */
  .related-title { font-size: 21px; line-height: 28px; letter-spacing: 0; min-height: 84px; }
</style>
