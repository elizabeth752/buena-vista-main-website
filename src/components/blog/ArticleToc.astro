---
/* In-article table of contents, built from the H2s. Sticky beside the body on
   desktop. Anchors are generated from the heading text and must match the ids
   the article template writes. */
interface Props { headings: { id: string; text: string }[]; }
const { headings } = Astro.props;
---
{headings.length > 2 && (
  <nav aria-label="On this page" class="lg:sticky lg:top-24 bg-cream rounded-xl border border-cream-soft border-t-4 border-t-gold p-6">
    <p class="font-body text-muted text-[13px] font-bold tracking-[0.12em] uppercase mb-4">On this page</p>
    <ol class="space-y-2.5">
      {headings.map(h => (
        <li>
          <a href={`#${h.id}`} class="font-body text-charcoal/80 hover:text-teal text-[15px] leading-[22px] transition-colors block">
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
