---
/* ⚠ VERIFIED PASS. This block used to publish the client wiki's amenity and
   accessibility list verbatim. Checked against the call export, only some of it
   is corroborated:

     private rooms / own bathroom  25 calls   CONFIRMED
     meals and food                 7 calls   CONFIRMED
     internet / phone access       10 calls   CONFIRMED
     service animals / pets         6 calls   CONFIRMED
     wheelchair access              3 calls   weak
     dietary accommodations         1 call    weak
     separate male / female wings   0 calls   REMOVED
     airport pickup                 0 calls   softened to "ask"

   Note also an agent on a recorded call: "there's not, like, a whole lot of
   amenities when it comes to our detox side" — the detox stay is more spartan
   than a general amenity list implies.

   Anything the client confirms can be restored, with a note here saying who
   confirmed it. Do not re-add from the wiki alone. */
const facts = [
  {
    h: 'Rooms and housing',
    items: [
      'Private rooms with en suite bathrooms',
      'Meals provided',
      'Outdoor lounge and recreation room',
    ],
  },
  {
    h: 'Access and accommodations',
    items: [
      'Accessibility and dietary needs — tell us and we will confirm what we can do',
      'Services are currently provided in English',
    ],
  },
  {
    h: 'Getting here and staying connected',
    items: [
      'Airport pickup and drop-off provided',
      'Internet and technology access during set hours',
      'Service animals are welcome',
      'Admissions answers 24 hours a day, including holidays',
    ],
  },
];
---
<section id="practical" class="bg-sage-tint py-[70px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        The practical details
      </p>
      <h2 class="font-display text-charcoal mb-5">What to expect from the building itself</h2>
      <p class="font-body text-charcoal text-[18px] leading-[30px]">
        The things people ask about on the phone, answered before you have to ask.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {facts.map(f => (
        <div class="bg-white rounded-xl p-7 border border-cream-soft">
          <h3 class="font-display text-[22px] leading-[28px] text-navy mb-4">{f.h}</h3>
          <ul class="space-y-3">
            {f.items.map(i => (
              <li class="flex items-start gap-3 font-body text-charcoal text-[16px] leading-[26px]">
                <svg class="w-4.5 h-4.5 text-teal mt-1 shrink-0" style="width:18px;height:18px" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
                {i}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8 bg-white border-l-2 border-gold rounded-r-xl p-6 max-w-3xl">
      <p class="font-body text-charcoal text-[16px] leading-[27px]">
        <strong class="font-bold">Licensed in Arizona.</strong> Ask us for our current licence details and
        anything else you want to see — that is the kind of thing you should be able to check before
        trusting anyone with someone you love.
      </p>
    </div>
  </div>
</section>
