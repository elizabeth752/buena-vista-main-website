---
import Horizon from '../Horizon.astro';

/* Hero standard, adapted for a location page: eyebrow, keyword H1, the NAP
   card, then bullets with their own icons, then CTAs. No subtitle paragraph
   and no styled display line.

   The NAP card holds the name, address and hours and must stay above the fold
   — it is what a local search lands here for. */
/* Accreditation marks in the hero, per the location-page checklist. The Google
   review rating is deliberately NOT shown: Chandler sits at 3.6, below the ~4.0
   threshold where a displayed rating helps rather than hurts. Revisit once the
   reputation work moves it. */
const badges = [
  { src: '/Asset/Accreditations/The%20Joint%20Commission.svg', alt: 'Accredited by The Joint Commission' },
  { src: '/Asset/Accreditations/Legit.svg',                    alt: 'LegitScript certified' },
  { src: '/Asset/Accreditations/NAATP.svg',                    alt: 'NAATP member' },
  { src: '/Asset/Accreditations/HIPAA%20Compliant.svg',        alt: 'HIPAA compliant' },
];

const points = [
  {
    text: 'Medical detox and residential treatment in one building',
    d: 'M21 8.25H3m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 8.25m18 0v10.5A2.25 2.25 0 0118.75 21H5.25A2.25 2.25 0 013 18.75V8.25M12 11.25v6m3-3H9',
  },
  {
    text: 'The only Buena Vista campus admitting right now',
    d: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
  },
  {
    text: 'Same-day admission when a bed is open',
    d: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    text: 'Transport can be arranged within our local service area',
    d: 'M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3',
  },
  {
    text: 'AHCCCS plans and most major commercial and private carriers',
    d: 'M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z',
  },
];
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,500px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Our Chandler facility
        </p>

        <h1 class="font-display text-navy mb-6">
          Drug and Alcohol Rehab in Chandler, Arizona
        </h1>

        <div class="bg-white border border-cream-soft rounded-xl p-6 mb-8 shadow-sm max-w-xl">
          <div class="flex items-start gap-3 mb-4">
            <span class="w-8 h-8 bg-gold rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-navy" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </span>
            <div>
              <p class="font-body font-bold text-charcoal text-[16px]">Buena Vista Health &amp; Recovery Centers</p>
              <p class="font-body text-charcoal text-[16px] leading-[26px]">3033 S Arizona Ave<br />Chandler, AZ 85286</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-cream-soft">
            <div>
              <p class="text-gold font-body text-xs font-bold uppercase tracking-wide mb-1">Hours</p>
              <p class="font-body text-charcoal text-[16px]">Open 24 hours, including holidays</p>
            </div>
            <div>
              <p class="text-gold font-body text-xs font-bold uppercase tracking-wide mb-1">Facility line</p>
              <a href="tel:4806800606" class="font-body text-charcoal text-[16px] tel-number hover:text-teal transition-colors">(480) 680-0606</a>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 mb-8">
          {badges.map(b => (
            <div class="bg-white rounded-lg px-3 py-2 flex items-center justify-center border border-cream-soft" style="min-width:80px; height:50px;">
              <img src={b.src} alt={b.alt} class="max-h-8 max-w-[88px] object-contain" loading="eager" />
            </div>
          ))}
        </div>

        <ul class="space-y-4 mb-9 max-w-xl">
          {points.map(item => (
            <li class="flex items-start gap-3.5 font-body text-charcoal text-[17px] leading-[29px]">
              <span class="w-9 h-9 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-[19px] h-[19px] text-teal" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
                </svg>
              </span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Talk to admissions
          </a>
          <a
            href="https://www.google.com/maps/dir/?api=1&destination=3033+S+Arizona+Ave,+Chandler,+AZ+85286"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body"
          >
            Get directions
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Chandler%20recovery%20center%20exterior%20with%20covered%20entrance%20and%20tower%20feature.png"
            alt="The Buena Vista Chandler facility — covered entrance and tower feature"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          Covered entrance on South Arizona Avenue. Someone is at the desk whatever time you arrive.
        </p>
      </div>

    </div>
  </div>
</section>
