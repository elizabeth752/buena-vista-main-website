---
import Horizon from '../Horizon.astro';
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,500px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Our facility · Chandler, Arizona
        </p>

        <h1 class="font-display text-navy mb-6">
          Detox and residential treatment in Chandler.
        </h1>

        <p class="font-body text-charcoal text-[20px] leading-[33px] max-w-xl mb-8">
          One building on South Arizona Avenue, open every hour of every day. This is where our care happens — and right now, it is the only Buena Vista campus admitting.
        </p>

        <div class="bg-white border border-cream-soft rounded-xl p-6 mb-8 shadow-sm max-w-xl">
          <div class="flex items-start gap-3 mb-4">
            <span class="w-8 h-8 bg-gold rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-navy" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </span>
            <div>
              <p class="font-body font-bold text-charcoal text-[16px]">Buena Vista Health &amp; Recovery Centers</p>
              <p class="font-body text-charcoal text-[16px] leading-[26px]">3033 S Arizona Ave<br />Chandler, AZ 85286</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-cream-soft">
            <div>
              <p class="text-gold font-body text-xs font-bold uppercase tracking-wide mb-1">Hours</p>
              <p class="font-body text-charcoal text-[16px]">Open 24 hours, including holidays</p>
            </div>
            <div>
              <p class="text-gold font-body text-xs font-bold uppercase tracking-wide mb-1">Facility line</p>
              <a href="tel:4806800606" class="font-body text-charcoal text-[16px] tel-number hover:text-teal transition-colors">(480) 680-0606</a>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Talk to admissions
          </a>
          <a
            href="https://www.google.com/maps/dir/?api=1&destination=3033+S+Arizona+Ave,+Chandler,+AZ+85286"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body"
          >
            Get directions
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Chandler%20recovery%20center%20exterior%20with%20covered%20entrance%20and%20tower%20feature.png"
            alt="The Buena Vista Chandler facility — covered entrance and tower feature"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          Covered entrance on South Arizona Avenue. Someone is at the desk whatever time you arrive.
        </p>
      </div>

    </div>
  </div>
</section>
