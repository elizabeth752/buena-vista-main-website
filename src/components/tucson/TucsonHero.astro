---
import Horizon from '../Horizon.astro';
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,460px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Tucson, Arizona
        </p>

        <div class="inline-flex items-center gap-2 bg-charcoal/5 text-muted font-body text-xs font-bold uppercase tracking-wide rounded-full px-4 py-2 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-muted"></span>
          Temporarily closed
        </div>

        <h1 class="font-display text-navy mb-6">
          Our Tucson campus is closed — southern Arizona still has options.
        </h1>

        <p class="font-body text-charcoal text-[20px] leading-[33px] max-w-xl mb-8">
          The Pima Street facility is not admitting at the moment while we work toward reopening it. If you were looking for Buena Vista in Tucson, you have not reached a dead end — there are two straightforward routes from here, and one phone call sorts out which one fits.
        </p>

        <div class="bg-white border border-cream-soft rounded-xl p-6 mb-9 max-w-xl shadow-sm">
          <p class="font-body font-semibold text-charcoal text-[17px] leading-[27px] mb-3">Either way, you get a plan today</p>
          <ul class="space-y-2.5">
            <li class="flex items-start gap-3 font-body text-charcoal text-[16px] leading-[26px]">
              <span class="w-1.5 h-1.5 rounded-full bg-gold mt-2.5 shrink-0"></span>
              Come to our Chandler facility, about two hours up the I-10 — we will help you work out getting there
            </li>
            <li class="flex items-start gap-3 font-body text-charcoal text-[16px] leading-[26px]">
              <span class="w-1.5 h-1.5 rounded-full bg-gold mt-2.5 shrink-0"></span>
              Or stay local, and we will help you find a Tucson programme that takes your insurance
            </li>
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span class="tel-number">Call (888) 362-5576</span>
          </a>
          <a href="/locations/chandler/" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            See the Chandler facility
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Tucson%20recovery%20center%20exterior%20with%20covered%20drop-off%20area%20and%20desert%20landscaping.png"
            alt="The Buena Vista Tucson building — covered drop-off area and desert landscaping"
            class="w-full object-cover aspect-[4/5] grayscale opacity-70"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          5151 E Pima St, Tucson, AZ 85712 — closed for now.
        </p>
      </div>

    </div>
  </div>
</section>
