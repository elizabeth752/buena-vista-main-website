---
import Horizon from '../Horizon.astro';

/* Hero standard: H1 carries the keyword, the emotional line sits above the
   bullets, no subtitle paragraph, every bullet gets its own icon.

   SAFETY: the 988 card stays in the hero, above the fold. This page draws
   people in the worst of it and that block is the reason it is here. Do not
   move it down the page.

   ⚠ MEDICATION BOUNDARY: we review what someone arrives on and arrange ongoing
   psychiatric care for afterwards. No on-site psychiatrist or prescribing
   claim. */
const points = [
  {
    text: 'Depression treated alongside substance use, in the same program',
    d: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  },
  {
    text: 'Our medical team reviews your medication as part of the assessment',
    d: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c.251.023.501.05.75.082M9.75 3.104a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.186c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15.75a9.065 9.065 0 00-6.23-.657L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
  },
  {
    text: 'The chemical low after heavy use lifts, and it lifts faster supported',
    d: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
  },
  {
    text: 'However bad it has been, you can say so out loud here',
    d: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
  },
  {
    text: 'Group therapy and one-to-one sessions, from the first week',
    d: 'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z',
  },
];
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,470px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Depression and substance use
        </p>

        <h1 class="font-display text-navy mb-6">
          Depression and Addiction Treatment in Chandler, Arizona
        </h1>

        <ul class="space-y-4 mb-9">
          {points.map(item => (
            <li class="flex items-start gap-3.5 font-body text-charcoal text-[17px] leading-[29px]">
              <span class="w-9 h-9 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-[19px] h-[19px] text-teal" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.d}/>
                </svg>
              </span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        <div class="bg-white border-l-2 border-gold rounded-r-xl p-6 mb-9 max-w-xl shadow-sm">
          <p class="font-body font-semibold text-charcoal text-[17px] leading-[27px] mb-2">If you are thinking about ending your life</p>
          <p class="font-body text-charcoal text-[16px] leading-[26px]">
            Call or text <a href="tel:988" class="text-teal font-semibold hover:opacity-70 transition-opacity tel-number">988</a> for the Suicide &amp; Crisis Lifeline, any hour of the day or night. If you are in immediate danger, call 911. Then call us. We will still be here, and plenty of people start from exactly where you are.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Talk to someone now
          </a>
          <a href="/dual-diagnosis" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            How dual diagnosis works
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Sunlit%20common%20hall%20with%20lounge%20furniture,%20tall%20windows,%20and%20open%20floor%20plan.png"
            alt="A sunlit common hall at Buena Vista in Chandler, with tall windows, a lit fireplace and armchairs in the light"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          Daylight, somewhere to sit, and people around when you are ready for them.
        </p>
      </div>

    </div>
  </div>
</section>
