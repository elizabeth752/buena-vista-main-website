---
import FAQ from '../FAQ.astro';
const faqs = [
  { q: 'Do you have a facility in Phoenix?', a: "No — one facility, in Chandler, at 3033 S Arizona Ave. We serve Phoenix from there, about half an hour south of the city. We would rather say that plainly than have you set out for an address that does not exist." },
  { q: 'How long is the drive?', a: "Around half an hour from central Phoenix outside of rush hour, straight down the I-10. Less from the south of the city, longer from the north or the West Valley." },
  { q: 'Can you help me get there?', a: "Often, yes. For many admissions we can arrange a car to bring you in, and ask us about airport pickup if you are flying into Sky Harbor. Many Access plans also include a medical transport benefit worth asking about." },
  { q: 'Can my family visit from Phoenix?', a: "That is part of why the distance works. Close enough that the people who matter can stay involved, far enough that you are genuinely away from things. Ask about current visiting arrangements when you call." },
  { q: 'What treatment is available?', a: "Medically supervised detox and residential treatment, with co-occurring mental health care throughout. Admissions answers 24 hours a day including holidays." },
  { q: 'Do you take AHCCCS?', a: "Access covers detox and residential treatment, and Banner University Family Care is in network with us. Other plan contracts are being reinstated, so give us the plan name on your card and we will check it on the call." },
  { q: 'How quickly could I come in?', a: "When a bed is open and coverage checks out, the same day. Bed availability moves daily, so a call gives you today's answer rather than an assumption." },
];
---
<FAQ
  faqs={faqs}
  eyebrow="Straight answers"
  heading="Questions from Phoenix"
  bg="bg-cream"
/>
