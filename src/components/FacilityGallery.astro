---
// Three photographs, shown at once. The previous carousel put eleven images
// behind eight dots of interaction; the brief asks for calm and spacious, and
// the photography is the strongest proof of "not an institution" on the page.
const BASE = '/Asset/stock%20photo/Desktop%20Dimensions/Facility/';

const photos = [
  {
    file: 'Private%20bedroom%20with%20upholstered%20bed,%20reading%20chair,%20and%20large%20window.png',
    alt: 'A private bedroom with an upholstered bed, reading chair, and large window',
    caption: 'Your own room, made up and quiet, with a door that closes.',
  },
  {
    file: 'Cafe-style%20dining%20room%20with%20round%20tables,%20upholstered%20chairs,%20and%20large%20windows.png',
    alt: 'Café-style dining room with round tables, upholstered chairs, and large windows',
    caption: 'Meals prepared daily, eaten at a table with other people.',
  },
  {
    file: 'Intimate%20fireside%20lounge%20with%20four%20armchairs%20and%20built-in%20fireplace.png',
    alt: 'An intimate fireside lounge with four armchairs and a built-in fireplace',
    caption: 'Somewhere to sit when you need to be out of your room.',
  },
].map(p => ({ ...p, src: BASE + p.file }));
---
<section id="facility-gallery" class="bg-sand py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-12 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        Our facility
      </p>
      <h2 class="font-display text-charcoal mb-4">
        Somewhere you would actually want to sleep
      </h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] max-w-2xl">
        These are our rooms and our common spaces — not stock photography, and not a rendering. It is a real place, and it was built to feel like one.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {photos.map(p => (
        <figure class="flex flex-col">
          <div class="overflow-hidden rounded-xl aspect-[4/3] bg-cream">
            <img
              src={p.src}
              alt={p.alt}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="font-body text-charcoal text-[16px] leading-[26px] mt-4">
            {p.caption}
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>
