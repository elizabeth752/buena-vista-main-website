---
const BASE = '/Asset/stock%20photo/Desktop%20Dimensions/Facility/';

const slides = [
  { file: 'Double-height%20social%20atrium%20with%20mixed%20seating%20and%20floor-to-ceiling%20windows.png',         alt: 'Open social atrium with floor-to-ceiling windows and natural light' },
  { file: 'Evening%20exterior%20facade%20with%20illuminated%20entrance%20and%20curved%20driveway.png',               alt: 'Facility exterior at evening with illuminated entrance' },
  { file: 'Intimate%20fireside%20lounge%20with%20four%20armchairs%20and%20built-in%20fireplace.png',                 alt: 'Intimate fireside lounge with built-in fireplace' },
  { file: 'Contemporary%20healthcare%20building%20with%20tower%20entry%20and%20desert%20landscaping.png',            alt: 'Modern healthcare campus with desert landscaping' },
  { file: 'Private%20conversation%20corner%20with%20upholstered%20seating%20and%20accent%20wall.png',               alt: 'Private conversation corner with upholstered seating' },
  { file: 'Covered%20drop-off%20entrance%20with%20tower%20feature%20and%20circular%20driveway.png',                 alt: 'Covered drop-off entrance with circular driveway' },
  { file: 'Central%20welcome%20desk%20with%20pendant%20lighting%20and%20adjacent%20activity%20area.png',             alt: 'Central welcome desk with pendant lighting' },
  { file: 'Street-facing%20building%20frontage%20with%20covered%20entry%20and%20evening%20exterior%20lighting.png', alt: 'Street-facing building frontage with evening lighting' },
  { file: 'Single-story%20healthcare%20campus%20with%20desert%20landscaping%20and%20extended%20facade.png',         alt: 'Single-story healthcare campus with extended facade' },
  { file: 'Central%20nurse%20station%20with%20surrounding%20corridors%20and%20administrative%20work%20area.png',    alt: 'Central nurse station with surrounding corridors' },
  { file: 'Mailroom%20and%20resident%20commons%20with%20seating%20clusters%20and%20storage%20wall.png',             alt: 'Resident commons with seating clusters' },
].map(s => ({ ...s, src: BASE + s.file }));
---

<section id="facility-gallery" class="bg-navy-deep py-[50px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-10">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center justify-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        Our Facility
        <span class="w-6 h-px bg-gold inline-block"></span>
      </p>
      <h2 class="font-display text-white mb-3">
        A Place Built for Healing
      </h2>
      <p class="font-body text-white/60 max-w-lg mx-auto text-sm">
        Comfortable. Structured. Purpose-built for recovery work — not just a place to stay.
      </p>
    </div>

    <!-- Carousel wrapper -->
    <div class="relative">

      <!-- Overflow container -->
      <div
        class="overflow-hidden rounded-xl cursor-grab active:cursor-grabbing select-none"
        id="gal-outer"
        style="touch-action: pan-y; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none;"
      >
        <!-- Sliding track -->
        <div
          id="gal-track"
          class="flex"
          style="gap: 12px; transition: transform 0.45s cubic-bezier(0.25,0.46,0.45,0.94); will-change: transform;"
        >
          {slides.map(s => (
            <div class="gal-slide flex-shrink-0 w-full md:w-[calc(50%-6px)]">
              <div class="aspect-[16/10] overflow-hidden rounded-xl bg-navy">
                <img
                  src={s.src}
                  alt={s.alt}
                  class="w-full h-full object-cover pointer-events-none"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Prev button -->
      <button
        id="gal-prev"
        aria-label="Previous"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 md:-translate-x-5 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white flex items-center justify-center backdrop-blur-sm transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Next button -->
      <button
        id="gal-next"
        aria-label="Next"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 md:translate-x-5 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white flex items-center justify-center backdrop-blur-sm transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

    <!-- Dot indicators -->
    <div class="flex items-center justify-center gap-2 mt-6" id="gal-dots">
      {slides.map((_, i) => (
        <button
          class="gal-dot h-1.5 rounded-full transition-all duration-300"
          style={i === 0 ? 'width:20px; background:#B9975B;' : 'width:6px; background:rgba(255,255,255,0.25);'}
          aria-label={`Go to slide ${i + 1}`}
          data-i={i}
        ></button>
      ))}
    </div>

  </div>
</section>

<script>
(function () {
  const section = document.getElementById('facility-gallery') as HTMLElement | null;
  const outer  = document.getElementById('gal-outer')  as HTMLElement | null;
  const track  = document.getElementById('gal-track')  as HTMLElement | null;
  const prev   = document.getElementById('gal-prev')   as HTMLButtonElement | null;
  const next   = document.getElementById('gal-next')   as HTMLButtonElement | null;
  const dotEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.gal-dot'));

  if (!section || !outer || !track || !prev || !next) return;

  const slides = Array.from(track.children) as HTMLElement[];
  const N   = slides.length;
  const GAP = 12;
  const AUTOPLAY_MS = 3500;
  const defaultTransition = track.style.transition;

  let cur = 0;
  let autoplayTimer: ReturnType<typeof setInterval> | null = null;
  let isInView = false;
  let isDragging = false;
  let dragStartX = 0;
  let dragStartTranslate = 0;
  let dragDelta = 0;

  function visible(): number {
    return window.innerWidth >= 768 ? 2 : 1;
  }

  function step(): number {
    return (slides[0]?.offsetWidth ?? outer.offsetWidth) + GAP;
  }

  function maxIdx(): number {
    return Math.max(0, N - visible());
  }

  // Wraps the index so next()/prev() loop forever instead of stopping at the ends.
  function wrap(i: number): number {
    const span = maxIdx() + 1;
    return ((i % span) + span) % span;
  }

  function render(): void {
    track.style.transform = `translateX(-${cur * step()}px)`;
    const max = maxIdx();
    dotEls.forEach((d, idx) => {
      if (idx > max) { d.style.display = 'none'; return; }
      d.style.display = '';
      d.style.width           = idx === cur ? '20px' : '6px';
      d.style.backgroundColor = idx === cur ? '#B9975B' : 'rgba(255,255,255,0.25)';
    });
  }

  function go(i: number): void {
    cur = wrap(i);
    render();
  }

  function startAutoplay(): void {
    if (autoplayTimer) return;
    autoplayTimer = setInterval(() => go(cur + 1), AUTOPLAY_MS);
  }

  function stopAutoplay(): void {
    if (!autoplayTimer) return;
    clearInterval(autoplayTimer);
    autoplayTimer = null;
  }

  // Autoplay only runs while the gallery is on screen and the user isn't dragging it.
  function syncAutoplay(): void {
    if (isInView && !isDragging) startAutoplay();
    else stopAutoplay();
  }

  prev.addEventListener('click', () => go(cur - 1));
  next.addEventListener('click', () => go(cur + 1));
  dotEls.forEach((d, i) => d.addEventListener('click', () => go(i)));
  window.addEventListener('resize', () => go(cur));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        isInView = entry.isIntersecting;
        syncAutoplay();
      }
    },
    { threshold: 0.4 }
  );
  observer.observe(section);

  // Press-and-drag (mouse or touch) scrolling — pauses autoplay while dragging.
  function onPointerDown(e: PointerEvent): void {
    isDragging = true;
    dragStartX = e.clientX;
    dragStartTranslate = -cur * step();
    dragDelta = 0;
    track.style.transition = 'none';
    outer.setPointerCapture(e.pointerId);
    syncAutoplay();
  }

  function onPointerMove(e: PointerEvent): void {
    if (!isDragging) return;
    dragDelta = e.clientX - dragStartX;
    track.style.transform = `translateX(${dragStartTranslate + dragDelta}px)`;
  }

  function onPointerUp(): void {
    if (!isDragging) return;
    isDragging = false;
    track.style.transition = defaultTransition;

    const threshold = step() * 0.2;
    if (dragDelta <= -threshold) go(cur + 1);
    else if (dragDelta >= threshold) go(cur - 1);
    else render();

    syncAutoplay();
  }

  outer.addEventListener('pointerdown', onPointerDown);
  outer.addEventListener('pointermove', onPointerMove);
  outer.addEventListener('pointerup', onPointerUp);
  outer.addEventListener('pointercancel', onPointerUp);

  render();
})();
</script>
