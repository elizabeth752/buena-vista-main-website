---
import Horizon from '../Horizon.astro';
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[60px] lg:py-[80px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,470px)] gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Bed availability · Chandler, Arizona
        </p>

        <h1 class="font-display text-navy mb-6">
          Do you have a bed today?
        </h1>

        <p class="font-body text-charcoal text-[20px] leading-[33px] max-w-xl mb-8">
          It is the first thing most people ask, and the only honest way to answer it is on the phone. Availability moves daily — sometimes hourly — so any number printed on a website is already out of date by the time you read it.
        </p>

        <div class="bg-white border border-cream-soft rounded-xl p-6 mb-9 max-w-xl shadow-sm">
          <p class="font-body font-semibold text-charcoal text-[17px] leading-[27px] mb-2">
            What you will get from one call
          </p>
          <ul class="space-y-2.5">
            {[
              'Whether there is a bed right now, in plain terms',
              'Which level of care you would be admitted to',
              'Whether your insurance is in network, checked while you wait',
              'A plan either way — including if the answer today is no',
            ].map(x => (
              <li class="flex items-start gap-3 font-body text-charcoal text-[16px] leading-[26px]">
                <span class="w-1.5 h-1.5 rounded-full bg-gold mt-2.5 shrink-0"></span>
                {x}
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:8883625576" class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span class="tel-number">Ask about today — (888) 362-5576</span>
          </a>
          <a href="/admissions/" class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body">
            How admission works
          </a>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Private%20bedroom%20with%20upholstered%20bed,%20reading%20chair,%20and%20large%20window.png"
            alt="A private bedroom at Buena Vista with an upholstered bed and reading chair"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          When there is one, it is a private room with its own bathroom.
        </p>
      </div>
    </div>
  </div>
</section>
