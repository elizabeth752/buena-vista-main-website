---
import Horizon from './Horizon.astro';

/* SEO: the H1 leads with the search term and the location rather than the brand
   line. "A better view forward" was memorable but carried no keyword at all —
   it now runs as the subhead where it still does its emotional work.

   The three points are deliberately specific. The previous set ("someone real
   answers", "most insurance accepted") described what any treatment centre
   would claim. These are things competitors mostly cannot say, and each is
   corroborated on recorded admissions calls:
     private room + own bathroom   — 25 calls
     physician within 24h, daily   — "you'll see a physician within the first
                                      twenty four hours and daily after that"
     detox and residential in one building, no second admission
*/
const usps = [
  {
    h: 'Your own room, and your own bathroom',
    p: 'Not a shared ward. Rare at this level of care, and the thing people are most surprised by when they arrive.',
  },
  {
    h: 'A physician within 24 hours, then every day',
    p: 'Detox here is a medical process with a doctor attached, not a room you wait in.',
  },
  {
    h: 'Detox and residential under one roof',
    p: 'You are not discharged mid-way and sent to find a second facility during the hardest fortnight.',
  },
];

/* Trust marks. No invented star rating or review count — the Google badge links
   down to the real reviews already on the page. Add an aggregate rating only
   once the Google Place ID is available and it can be pulled rather than typed. */
const badges = [
  { src: '/Asset/Accreditations/The%20Joint%20Commission.svg', alt: 'Accredited by The Joint Commission' },
  { src: '/Asset/Accreditations/Legit.svg', alt: 'LegitScript certified' },
  { src: '/Asset/Accreditations/NAATP.svg', alt: 'NAATP member' },
  { src: '/Asset/Accreditations/BBB.svg', alt: 'BBB accredited' },
];
---
<section id="hero" class="bg-cream">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-[52px] pb-[40px] lg:pt-[70px] lg:pb-[52px]">
    <div class="grid lg:grid-cols-[1fr_minmax(0,520px)] gap-12 lg:gap-16 items-center">

      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-5 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Medical detox &amp; residential treatment · Chandler, Arizona
        </p>

        <h1 class="font-display text-navy mb-5">
          Drug and alcohol treatment in Chandler, Arizona.
        </h1>

        <p class="font-body text-charcoal text-[20px] leading-[33px] max-w-xl mb-9">
          A better view forward — in a place that treats you like a person, not a number.
          Someone real answers the phone at any hour, including holidays.
        </p>

        <ul class="space-y-4 mb-9">
          {usps.map(item => (
            <li class="flex items-start gap-3.5">
              <svg class="w-5 h-5 text-teal mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span class="font-body text-charcoal">
                <strong class="font-bold block text-[17px] leading-[26px]">{item.h}</strong>
                <span class="text-[16px] leading-[26px] text-charcoal/85">{item.p}</span>
              </span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row gap-4 mb-9">
          <a
            href="tel:8883625576"
            class="inline-flex items-center justify-center gap-2 bg-teal hover:bg-teal-dark text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span class="tel-number">Call (888) 362-5576</span>
          </a>
          <a
            href="#verify"
            class="inline-flex items-center justify-center border-2 border-navy text-navy hover:bg-navy hover:text-white font-semibold h-14 px-8 rounded-lg transition-colors font-body"
          >
            Check my insurance
          </a>
        </div>

        <!-- Trust strip: accreditations plus a link to the real reviews below. -->
        <div class="flex flex-wrap items-center gap-2.5 pt-7 border-t border-cream-soft">
          {badges.map(b => (
            <div class="bg-white rounded-lg px-3 py-2 flex items-center justify-center border border-cream-soft" style="min-width:72px; height:46px;">
              <img src={b.src} alt={b.alt} class="h-7 max-w-[78px] object-contain" loading="lazy" />
            </div>
          ))}
          <a href="#reviews" class="bg-white rounded-lg px-3 py-2 flex items-center gap-2.5 border border-cream-soft hover:border-teal transition-colors" style="height:46px;">
            <img src="/Asset/Accreditations/Google-Reviews.svg" alt="Google Reviews" class="h-6 max-w-[84px] object-contain" loading="lazy" />
            <span class="font-body text-[13px] font-bold text-charcoal whitespace-nowrap" aria-label="Five star reviews">★★★★★</span>
          </a>
        </div>
      </div>

      <!-- The lobby, not a bedroom. It is the strongest shot in the library and
           it reads as "not an institution" faster than any sentence does. -->
      <div>
        <div class="overflow-hidden rounded-t-[160px] rounded-b-xl shadow-xl">
          <img
            src="/Asset/stock%20photo/Desktop%20Dimensions/Facility/Open%20concierge%20lobby%20with%20reception%20counter,%20double-height%20ceiling,%20and%20wood%20flooring.png"
            alt="The lobby at Buena Vista — a double-height concierge space with a reception counter and wood flooring"
            class="w-full object-cover aspect-[4/5]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <Horizon variant="rule" class="mt-5" />
        <p class="font-body text-muted text-[15px] leading-[24px] mt-3">
          You walk into a lobby, not an intake window.
        </p>
      </div>

    </div>
  </div>
</section>
