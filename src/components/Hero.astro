---
import InsuranceForm from './InsuranceForm.astro';
---
<section
  id="hero"
  class="relative bg-navy-deep text-white overflow-hidden"
  style="background-image: linear-gradient(to right, rgba(10,20,35,0.82) 40%, rgba(10,20,35,0.38) 100%), url('/Asset/stock%20photo/Desktop%20Dimensions/Banner.png'); background-size: cover; background-position: center top;"
>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-[50px]">
    <div class="grid lg:[grid-template-columns:1fr_400px] gap-10 items-start">

      <!-- Left: Copy -->
      <div>
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          Addiction Treatment · Chandler, Arizona
        </p>
        <h1 class="font-display text-[48px] tracking-[-1px] md:text-6xl md:tracking-[0.02em] lg:text-[68px] leading-none mb-5 text-white">
          Honest, Structured Addiction Treatment in Arizona
        </h1>

        <ul class="space-y-2.5 mb-8">
          {[
            'Private rooms with en suite bathrooms — your space, your dignity',
            'Meals prepared daily by a dedicated culinary team',
            'Technology access 4 PM – 10 PM so you stay connected to what matters',
            'Full continuum: detox, residential, IOP, and outpatient',
            'Dual diagnosis support — we treat the whole picture, not just the substance',
          ].map(item => (
            <li class="flex items-start gap-3 text-sm font-body text-white/90">
              <svg class="w-5 h-5 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <!-- Accreditation badges: white pill containers let true colors show -->
        <div class="grid grid-cols-3 md:flex md:flex-wrap items-center gap-3 mb-8">
          {[
            { src: '/Asset/Accreditations/The%20Joint%20Commission.svg', alt: 'The Joint Commission Accredited' },
            { src: '/Asset/Accreditations/psychology_today%201.svg',      alt: 'Psychology Today Verified' },
            { src: '/Asset/Accreditations/Legit.svg',                     alt: 'LegitScript Certified' },
            { src: '/Asset/Accreditations/NAATP.svg',                     alt: 'NAATP Member' },
            { src: '/Asset/Accreditations/BBB.svg',                       alt: 'BBB Accredited' },
          ].map(b => (
            <div class="bg-white rounded-lg px-3 py-2 flex items-center justify-center shadow-sm" style="min-width:64px; height:44px;">
              <img src={b.src} alt={b.alt} class="h-7 max-w-[72px] object-contain" />
            </div>
          ))}
        </div>

        <a href="tel:8883625576" class="inline-flex items-center gap-2 bg-white hover:bg-cream text-black font-bold px-7 py-3.5 rounded transition-colors font-body tracking-wide">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          Speak With Someone Now
        </a>
      </div>

      <!-- Right: Insurance Verify Form (desktop only — mobile version lives after the FAQ section) -->
      <InsuranceForm id="verify" class="hidden lg:block" />

    </div>
  </div>
</section>
