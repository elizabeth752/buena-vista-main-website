---
import RevealCards from '../RevealCards.astro';

/* Fentanyl detox IS offered — this is core scope, unlike the meth page. Note
   the co-use figures behind the third card: meth appears alongside fentanyl in
   ~36% of these calls and alcohol in ~33%, so one admission covering both is
   the common case rather than the exception. */
const detail = [
  {
    h: 'Five to seven days',
    p: 'Long enough to get through the worst of it properly rather than be turned out halfway. How much, how long, and what your body does all move the number, and your team tells you what they are seeing.',
  },
  {
    h: 'Medication from day one',
    p: 'Nobody is left to white-knuckle withdrawal in a room. Comfort medication is part of the process here, prescribed under physician oversight and adjusted as the days move rather than set once.',
  },
  {
    h: 'More than one substance',
    p: 'Meth alongside fentanyl is common, and so is alcohol. Your detox is planned around everything in the picture at once, as one admission rather than a sequence of separate ones.',
  },
  {
    h: 'Then what keeps it',
    p: 'Detox settles the body. Residential is where the reasons get worked on, in the same building with the same team, so there is no gap between the two for anyone to fall through.',
  },
];
---
<section id="detox" class="bg-white py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-16 items-start">

      <div class="lg:sticky lg:top-24">
        <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
          <span class="w-6 h-px bg-gold inline-block"></span>
          The detox
        </p>
        <h2 class="font-display text-charcoal mb-6">What coming off fentanyl looks like here</h2>

        <div class="space-y-5 font-body text-charcoal text-[17px] leading-[29px]">
          <p>
            Fentanyl withdrawal comes on fast and hard, and it is the reason most attempts to stop at home come apart within a day. There is nothing weak about that — it is a physiological process, and it responds to being treated as one.
          </p>
          <p>
            A medical detox means nursing staff on site every hour of the day, a physician overseeing your care, and medication to blunt the worst of the symptoms. You are monitored, kept as comfortable as the situation allows, and not alone for any of it.
          </p>
          <p>
            <strong class="font-bold">Having used an hour ago is not a problem.</strong> It is the most ordinary way this starts and it changes nothing about how you are treated. Tell us honestly when you last used, because it is the single most useful thing you can give us and it decides the timing of everything that follows.
          </p>
        </div>

        <div class="mt-8">
          <a href="tel:8883625576" class="bg-teal hover:bg-teal-dark text-white font-bold px-7 py-3.5 rounded-lg transition-colors font-body tracking-wide inline-block">
            Ask about a bed today
          </a>
        </div>
      </div>

      <RevealCards class="grid sm:grid-cols-2 gap-5 items-stretch">
        {detail.map(d => (
          <div class="reveal-card bg-cream rounded-xl p-7 border border-cream-soft border-t-4 border-t-gold h-full">
            <h3 class="fx-title font-display text-navy mb-3">{d.h}</h3>
            <p class="font-body text-charcoal text-[16px] leading-[26px]">{d.p}</p>
          </div>
        ))}
      </RevealCards>

    </div>
  </div>
</section>

<style>
  /* Unlayered, so it beats the global h3 scale. */
  .fx-title { font-size: 21px; line-height: 27px; letter-spacing: 0; }
</style>
