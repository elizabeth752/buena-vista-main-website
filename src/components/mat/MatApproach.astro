---
// Stigma reduction plus the taper-focused philosophy, kept general. No
// outcome claims, no statistics, no specific protocols.
const myths = [
  {
    myth: '"It is just swapping one drug for another."',
    truth: 'Taken as prescribed under medical supervision, buprenorphine stabilizes your brain chemistry and quiets the cravings and withdrawal that drive relapse. It is prescribed at a controlled dose, as part of a treatment plan. That is a different thing from active addiction, and most people can feel the difference within days.',
  },
  {
    myth: '"Needing medication means I failed at recovery."',
    truth: 'It does not. Medication is a legitimate part of modern addiction care, and choosing it is not a shortcut or a moral compromise. Nobody here will make you feel otherwise — a good number of our staff have been through this themselves.',
  },
  {
    myth: '"If I start, I will be on it forever."',
    truth: 'Our philosophy leans toward using medication as a supported bridge: stabilizing you first, then tapering gradually when you and your clinical team agree the time is right. We do not rush that, and we do not make it a one-size-fits-all rule.',
  },
];
---
<section id="approach" class="bg-cream py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-12 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        What MAT actually is
      </p>
      <h2 class="font-display text-charcoal mb-4">
        Clearing up what people get told about medication
      </h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] max-w-2xl">
        Medication-assisted treatment means using approved medications alongside counseling and therapy to treat opioid and alcohol use disorders. It carries more shame and misinformation than almost anything else in recovery, so it is worth being direct.
      </p>
    </div>

    <div class="space-y-5 max-w-4xl">
      {myths.map(m => (
        <div class="bg-white rounded-xl p-8 border border-cream-soft">
          <p class="font-display text-2xl text-muted mb-3">{m.myth}</p>
          <p class="font-body text-charcoal text-[17px] leading-[29px]">{m.truth}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 flex gap-4 bg-navy rounded-xl p-7 text-white max-w-4xl">
      <svg class="w-6 h-6 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
      </svg>
      <p class="font-body text-white/85 text-[16px] leading-[26px]">
        <strong class="text-white font-bold">Medication is never the whole plan here.</strong> Alongside it you will have medical supervision, group therapy, one-on-one counseling, and a case manager. The medication quiets the physical noise so you can actually do the rest of the work — that combination is the point.
      </p>
    </div>

  </div>
</section>
