---
// The brief calls this the most valuable thing on the page: it sets
// expectations, builds trust, and filters out leads the program cannot serve.
// No dose numbers, no protocols, no prescriber names — those require written
// clinical sign-off before they can appear anywhere.
const canDo = [
  'Include medication-assisted treatment — primarily buprenorphine — in medically supervised detox and residential care, when it is clinically right for you',
  'Continue your existing methadone treatment if you are already established with Community Medical Services, coordinating with them so your care is not interrupted',
  'Use medication to make withdrawal safer and more comfortable',
  'Support a gradual, supervised taper when that is what you want',
];

const cannotDo = [
  'We are not a methadone clinic, and we do not start or dispense methadone ourselves',
  'We do not provide standalone, long-term methadone maintenance dosing',
  'We are not a walk-in medication or dosing service — medication support sits inside our treatment programs',
];
---
<section id="scope" class="bg-white py-[60px]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

    <div class="mb-12 max-w-3xl">
      <p class="text-gold font-body text-xs font-bold tracking-[0.18em] uppercase mb-4 flex items-center gap-2">
        <span class="w-6 h-px bg-gold inline-block"></span>
        Being clear about scope
      </p>
      <h2 class="font-display text-charcoal mb-4">
        What we can do, and what we cannot
      </h2>
      <p class="font-body text-charcoal text-[17px] leading-[29px] max-w-2xl">
        People arrive expecting a methadone program and find something different, which helps nobody. So here is the honest shape of what we offer, before you spend any more of your time.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">

      <div class="bg-cream rounded-xl p-8 border border-cream-soft">
        <h3 class="font-display text-2xl text-charcoal mb-5">What we can do</h3>
        <ul class="space-y-4">
          {canDo.map(item => (
            <li class="flex gap-4">
              <div class="w-6 h-6 rounded-full bg-teal/15 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-teal" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
              </div>
              <p class="font-body text-charcoal text-[16px] leading-[26px]">{item}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-cream rounded-xl p-8 border border-cream-soft">
        <h3 class="font-display text-2xl text-charcoal mb-5">What we do not do</h3>
        <ul class="space-y-4">
          {cannotDo.map(item => (
            <li class="flex gap-4">
              <div class="w-6 h-6 rounded-full bg-navy/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-navy" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </div>
              <p class="font-body text-charcoal text-[16px] leading-[26px]">{item}</p>
            </li>
          ))}
        </ul>
        <p class="font-body text-charcoal text-[16px] leading-[26px] mt-6 pt-6 border-t border-cream-soft">
          If long-term maintenance dosing is what you need, we will help point you toward a provider who does that properly — Community Medical Services among them — so your care stays safe and continuous.
        </p>
      </div>

    </div>
  </div>
</section>
